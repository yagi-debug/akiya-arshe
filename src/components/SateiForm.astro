---
import { SERVICE_PREFECTURES } from "../data/service-area.mjs";
const { id = "satei" } = Astro.props;
const LINE_URL = "https://line.arshe1719.workers.dev/auth/line?ref=hp";
---

<div id={`${id}-wrap`} class="satei-wrap rounded-2xl border border-border bg-white p-5 shadow-md sm:p-8">
  <p class="mb-2 text-lg font-bold text-primary">無料査定の前に、物件の情報を整理できます</p>
  <p class="mb-5 text-sm leading-relaxed text-text-light">入力した内容をこの画面で相談準備メモにまとめます。自動で相談を送信することはありません。価格は所在地・建物・賃貸状況などを確認して個別にご案内します。</p>
  <div class="satei-prepare-form space-y-5">
    <div>
      <label for={`${id}-type`} class="mb-1 block text-sm font-bold text-text">物件の種類（任意）</label>
      <select id={`${id}-type`} name="property_type" class="w-full rounded-lg border border-border bg-white px-4 py-3 text-base">
        <option value="不明">不明・まだ確認していない</option>
        {["アパート（一棟）", "一戸建て", "土地", "マンション", "共有持分", "その他"].map(type => <option>{type}</option>)}
      </select>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-pref`} class="mb-1 block text-sm font-bold text-text">物件の所在地（府県・任意）</label>
        <select id={`${id}-pref`} name="prefecture" class="w-full rounded-lg border border-border bg-white px-4 py-3 text-base">
          <option value="不明">不明・まだ確認していない</option>
          {SERVICE_PREFECTURES.map(pref => <option>{pref}</option>)}
        </select>
      </div>
      <div>
        <label for={`${id}-city`} class="mb-1 block text-sm font-bold text-text">市区町村（任意）</label>
        <input id={`${id}-city`} name="city" type="text" placeholder="例：大阪市生野区" maxlength="80" class="w-full rounded-lg border border-border px-4 py-3 text-base" />
      </div>
    </div>
    <p class="text-xs text-text-light">大阪・兵庫・京都・奈良・滋賀・和歌山の物件が対象です。所有者のお住まいは問いません。買取の可否は個別に確認します。</p>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-age`} class="mb-1 block text-sm font-bold text-text">築年数（任意）</label>
        <select id={`${id}-age`} name="age" class="w-full rounded-lg border border-border bg-white px-4 py-3 text-base">
          <option value="不明">不明・まだ確認していない</option>
          {["築10年以内", "築11〜20年", "築21〜30年", "築31年以上"].map(age => <option>{age}</option>)}
        </select>
      </div>
      <div>
        <label for={`${id}-area`} class="mb-1 block text-sm font-bold text-text">土地面積（㎡・任意）</label>
        <input id={`${id}-area`} name="area" type="number" min="0.01" max="99999" step="0.01" placeholder="例：100。不明なら空欄" class="w-full rounded-lg border border-border px-4 py-3 text-base" />
      </div>
    </div>
    <div>
      <label for={`${id}-occupancy`} class="mb-1 block text-sm font-bold text-text">入居状況（任意）</label>
      <select id={`${id}-occupancy`} name="occupancy" class="w-full rounded-lg border border-border bg-white px-4 py-3 text-base">
        <option value="不明">不明・まだ確認していない</option>
        {["入居中", "一部空室", "全室空室", "該当しない（土地など）"].map(value => <option>{value}</option>)}
      </select>
    </div>
    <button type="button" class="satei-prepare-button w-full rounded-lg bg-primary px-5 py-3 font-bold text-white">相談準備メモを作る（送信しません）</button>
  </div>
  <div class="satei-memo-result mt-6 rounded-xl border border-primary/20 bg-bg p-4" hidden aria-live="polite">
    <p class="mb-2 font-bold text-primary">相談準備メモ</p>
    <label for={`${id}-memo`} class="mb-2 block text-sm text-text-light">必要なら内容を編集して、LINEやフォームの相談内容にコピーしてください。</label>
    <textarea id={`${id}-memo`} class="satei-memo w-full rounded-lg border border-border bg-white p-3 text-sm" rows="9"></textarea>
    <p class="mt-2 text-xs text-text-light">表示しただけでは相談は送信されません。相談先で送信内容を確認してください。</p>
  </div>
  <div class="mt-6 border-t border-border pt-5 text-center">
    <p class="mb-3 text-sm font-bold text-primary">わからない項目があっても、そのまま相談できます</p>
    <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center rounded-xl bg-[#06C755] px-5 py-4 font-bold text-white">LINEで無料相談する（24時間受付）</a>
    <a href="/contact/" class="mt-3 inline-block text-sm font-bold text-primary underline">フォームで無料相談する</a>
    <p class="mt-3 text-xs text-text-light">相談・査定無料。売却を決めていない段階でも受け付けています。</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".satei-wrap").forEach(wrap => {
    const fields = wrap.querySelector<HTMLElement>(".satei-prepare-form");
    const button = wrap.querySelector<HTMLButtonElement>(".satei-prepare-button");
    const result = wrap.querySelector<HTMLElement>(".satei-memo-result");
    const memo = wrap.querySelector<HTMLTextAreaElement>(".satei-memo");
    button?.addEventListener("click", () => {
      if (!result || !memo) return;
      const value = (key: string) => fields?.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${key}"]`)?.value.trim() || "不明";
      const area = value("area");
      memo.value = [
        `物件の種類：${value("property_type")}`,
        `所在地：${value("prefecture")} ${value("city")}`,
        `築年数：${value("age")}`,
        `土地面積：${area === "不明" ? area : `${area}㎡`}`,
        `入居状況：${value("occupancy")}`,
        "売却を考えた理由・困っていること：",
        "希望する時期：未定",
      ].join("\n");
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  });
</script>

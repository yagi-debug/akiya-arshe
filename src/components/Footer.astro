---
const sitemapLinks = [
  { label: "ホーム", href: "/" },
  { label: "無料AI査定", href: "/satei" },
  { label: "売却ガイド", href: "/guide" },
  { label: "対応物件", href: "/area" },
  { label: "よくある質問", href: "/faq" },
  { label: "お問い合わせ", href: "/contact" },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-primary text-white">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <!-- 会社情報 -->
      <div>
        <h3 class="mb-3 text-lg font-bold text-accent">会社情報</h3>
        <div class="space-y-3 text-sm text-white/80">
          <p>宅建業免許: 大阪府知事 (1) 第65646号</p>
          <a
            href="/about"
            class="inline-block text-accent-light underline-offset-2 hover:text-accent hover:underline"
          >
            会社概要を見る →
          </a>
        </div>
      </div>

      <!-- サイトマップ -->
      <div>
        <h3 class="mb-3 text-lg font-bold text-accent">サイトマップ</h3>
        <ul class="space-y-2 text-sm">
          {sitemapLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-white/80 transition-colors hover:text-accent-light"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- その他リンク -->
      <div>
        <h3 class="mb-3 text-lg font-bold text-accent">その他</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/about"
              class="text-white/80 transition-colors hover:text-accent-light"
            >
              会社概要
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="text-white/80 transition-colors hover:text-accent-light"
            >
              プライバシーポリシー
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- コピーライト -->
    <div class="mt-8 border-t border-white/20 pt-6 text-center text-xs text-white/60">
      <p>&copy; {currentYear} 空き家のミカタ（宅建業免許: 大阪府知事 (1) 第65646号） All Rights Reserved.</p>
    </div>
  </div>
</footer>

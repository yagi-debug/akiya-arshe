---
// サイト共通CTA（全ページ下部）
// 設計意図: このサイトの読者は「LINEを追加したら何が起きるのか」への不安が最大の障壁。
// ボタンを増やすのではなく、追加後の流れ（3ステップ）と「勧誘しない」約束、
// 対応する人間（宅建士）を見せることで心理的ハードルを下げる。
import LineIcon from "./LineIcon.astro";
const LINE_URL = "https://lin.ee/9Fk9EUl";
---
<section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary to-primary-dark px-4 py-16 text-white md:py-20">
  <div class="blob left-[-100px] top-[-60px] h-72 w-72 bg-accent/20"></div>
  <div class="blob bottom-[-120px] right-[-80px] h-80 w-80 bg-primary-light/40"></div>
  <div class="relative mx-auto max-w-3xl">
    <div class="text-center">
      <p class="mb-3 inline-flex items-center gap-3 text-xs font-bold tracking-[0.3em] text-accent-light">ご相談はこちら</p>
      <h2 class="serif mb-3 text-2xl leading-relaxed md:text-3xl">
        相続・空き家・訳あり不動産のお悩み、<br class="md:hidden" />状況だけでもお聞かせください
      </h2>
      <p class="mb-8 text-sm leading-relaxed text-white/80 md:text-base">
        <strong class="text-white">相談だけで大丈夫です。</strong>売るかどうか決まっていなくても構いません。<br class="hidden md:block" />
        しつこい勧誘や営業電話は一切いたしません。
      </p>
    </div>

    <!-- LINE相談の流れ（3ステップ） -->
    <div class="mb-8 grid gap-3 sm:grid-cols-3">
      {[
        { num: "1", title: "友だち追加", desc: "下のボタンを押すだけ。登録情報の入力は不要です" },
        { num: "2", title: "状況を送る", desc: "物件の場所と状況を、わかる範囲で送ってください。写真があればより正確です" },
        { num: "3", title: "宅建士が返信", desc: "買取できるか・いくらくらいかを、原則24時間以内にお答えします" },
      ].map((step) => (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-5 text-center backdrop-blur-sm">
          <div class="mx-auto mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-accent text-sm font-black text-white">{step.num}</div>
          <p class="mb-1 text-sm font-black text-white">{step.title}</p>
          <p class="text-xs leading-relaxed text-white/70">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center">
      <!-- LINEボタン（メイン） -->
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mb-3 inline-flex w-full max-w-md items-center justify-center gap-2 rounded-full bg-[#06C755] px-10 py-4 text-lg font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-[#05b64d] hover:shadow-xl"
      >
        <LineIcon class="h-6 w-6" />
        LINEで無料相談する
      </a>
      <p class="mb-6 text-xs text-white/60">友だち追加後、トークで話しかけてください（24時間受付）</p>

      <!-- 対応する人（信頼の顔） -->
      <div class="mx-auto mb-6 flex max-w-md items-center gap-3 rounded-2xl border border-white/10 bg-white/10 p-4 text-left backdrop-blur-sm">
        <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-accent text-xl font-bold text-white">八</div>
        <div>
          <p class="text-sm font-bold text-white">宅地建物取引士・八木 宏樹が直接対応します</p>
          <p class="text-xs text-white/70">合同会社アルシェ（宅建業免許: 大阪府知事(1)第65646号）</p>
        </div>
      </div>

      <!-- サブ導線 -->
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/satei"
          class="inline-block rounded-lg border-2 border-accent-light/70 px-6 py-2.5 text-sm font-bold text-white transition-all hover:border-accent-light hover:bg-white/10"
        >
          60秒でわかる無料AI査定 →
        </a>
        <a
          href="/contact"
          class="inline-block rounded-lg border-2 border-white/40 px-6 py-2.5 text-sm font-bold text-white transition-all hover:border-white/70 hover:bg-white/10"
        >
          フォームで相談する
        </a>
      </div>
      <p class="mt-3 text-xs text-white/60">
        メール: <a href="mailto:info.arshe@arshe-corp.com" class="underline hover:text-accent-light">info.arshe@arshe-corp.com</a>
      </p>

      <!-- 安心メッセージ -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-white/70 md:text-sm">
        {["相談・査定 無料", "秘密厳守", "全国対応", "しつこい勧誘なし"].map((label) => (
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            {label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

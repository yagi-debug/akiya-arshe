---
import LineIcon from "./LineIcon.astro";
const LINE_URL = "https://lin.ee/9Fk9EUl";
const navItems = [
  { label: "無料AI査定", href: "/satei" },
  { label: "売却ガイド", href: "/guide" },
  { label: "対応物件", href: "/area" },
  { label: "よくある質問", href: "/faq" },
  { label: "会社概要", href: "/about" },
];
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-white/90 shadow-sm backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <!-- ロゴ -->
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-white shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block text-lg font-black tracking-wide text-primary md:text-xl">空き家のミカタ</span>
        <span class="hidden text-[10px] font-medium tracking-widest text-text-light sm:block">訳あり不動産の買取専門｜全国対応</span>
      </span>
    </a>

    <!-- PCナビ -->
    <nav class="hidden items-center gap-5 lg:flex" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-bold text-text transition-colors hover:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- PC: CTAボタン -->
    <div class="hidden items-center gap-2 md:flex">
      <a
        href="/satei"
        class="rounded-full border-2 border-accent px-4 py-2 text-sm font-bold text-accent transition-all hover:bg-accent hover:text-white"
      >
        60秒AI査定
      </a>
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-full bg-[#06C755] px-4 py-2 text-sm font-bold text-white shadow transition-all hover:bg-[#05b64d] hover:shadow-md"
      >
        <LineIcon class="h-4 w-4" />
        無料相談
      </a>
    </div>

    <!-- スマホ: LINEボタン + ハンバーガー -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 rounded-full bg-[#06C755] px-3 py-2 text-sm font-bold text-white shadow"
        aria-label="LINEで相談"
      >
        <LineIcon class="h-4 w-4" />
        LINE
      </a>
      <button
        type="button"
        class="rounded-lg p-1.5 text-primary transition-colors hover:bg-primary/5"
        aria-label="メニューを開く"
        id="menu-toggle"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- モバイルメニュー -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-white md:hidden"
    aria-label="モバイルナビゲーション"
  >
    <ul class="flex flex-col">
      {[{ label: "ホーム", href: "/" }, ...navItems, { label: "お問い合わせ", href: "/contact" }].map((item) => (
        <li>
          <a
            href={item.href}
            class="block border-b border-border px-6 py-4 text-base font-bold text-text transition-colors hover:bg-primary/5 hover:text-accent"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="space-y-3 bg-bg px-6 py-5 text-center">
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#06C755] px-6 py-3.5 font-bold text-white shadow transition-all hover:bg-[#05b64d]"
      >
        <LineIcon class="h-5 w-5" />
        LINEで無料相談する
      </a>
      <a
        href="/satei"
        class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-accent px-6 py-3 font-bold text-accent"
      >
        60秒でわかる無料AI査定
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>

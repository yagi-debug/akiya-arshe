---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;

// 答えの中の内部リンク（<a href='/...' class='...'>文字</a>）だけをリンクとして表示し、それ以外の < > & は文字として出す。
// （タグがそのまま画面に出ると、構造化データの答え（タグ除去済み）と画面が食い違うため。2026-10-11）
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const ANCHOR = /<a href=(['"])(\/[^'"<>\s]*)\1(?: class=(['"])([^'"<>]*)\3)?>([^<>]*)<\/a>/g;
function renderAnswer(answer: string): string {
  let out = '';
  let last = 0;
  for (const m of answer.matchAll(ANCHOR)) {
    out += escapeHtml(answer.slice(last, m.index));
    const cls = m[4] ? ` class="${escapeHtml(m[4])}"` : '';
    out += `<a href="${escapeHtml(m[2])}"${cls}>${escapeHtml(m[5])}</a>`;
    last = (m.index ?? 0) + m[0].length;
  }
  return out + escapeHtml(answer.slice(last));
}
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="group overflow-hidden rounded-2xl border border-border bg-white shadow-[var(--shadow-soft)]">
      <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-4 text-left font-bold text-primary transition-colors hover:text-accent md:px-6 md:py-5">
        <span class="flex items-start gap-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-black text-accent">Q</span>
          <span class="pt-0.5">{item.question}</span>
        </span>
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-bg text-text-light transition-transform group-open:rotate-180">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="border-t border-border bg-bg/50 px-5 py-4 text-sm leading-relaxed text-text md:px-6 md:py-5">
        <div class="flex items-start gap-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-black text-white">A</span>
          <p class="pt-0.5" set:html={renderAnswer(item.answer)} />
        </div>
      </div>
    </details>
  ))}
</div>

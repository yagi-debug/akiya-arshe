---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '大阪市の訳あり物件買取', url: '/osaka' },
];

const wards = [
  { name: '北区', slug: 'osaka-kita', note: '梅田・天満' },
  { name: '都島区', slug: 'osaka-miyakojima', note: '京橋・野江内代' },
  { name: '福島区', slug: 'osaka-fukushima', note: '野田・海老江' },
  { name: '此花区', slug: 'osaka-konohana', note: '西九条・伝法' },
  { name: '中央区', slug: 'osaka-chuo', note: '谷町・難波' },
  { name: '西区', slug: 'osaka-nishi', note: '九条・新町' },
  { name: '港区', slug: 'osaka-minato', note: '弁天町・磯路' },
  { name: '大正区', slug: 'osaka-taisho', note: '大正・三軒家' },

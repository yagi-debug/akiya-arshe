  { name: '淀川区', slug: 'osaka-yodogawa', note: '十三・新大阪' },
  { name: '東淀川区', slug: 'osaka-higashiyodogawa', note: '淡路・上新庄' },
  { name: '東成区', slug: 'osaka-higashinari', note: '今里・深江橋' },
  { name: '生野区', slug: 'osaka-ikuno', note: '鶴橋・桃谷' },
  { name: '旭区', slug: 'osaka-asahi', note: '千林・森小路' },
  { name: '城東区', slug: 'osaka-joto', note: '蒲生四丁目・鴫野' },
  { name: '鶴見区', slug: 'osaka-tsurumi', note: '放出・今福鶴見' },
  { name: '阿倍野区', slug: 'osaka-abeno', note: '昭和町・文の里' },
  { name: '住之江区', slug: 'osaka-suminoe', note: '北加賀屋・住之江' },

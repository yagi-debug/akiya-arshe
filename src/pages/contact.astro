---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const breadcrumbs = [
  { name: "ホーム", url: "/" },
  { name: "お問い合わせ", url: "/contact" },
];
---

<BaseLayout
  title="無料相談・お問い合わせ｜相続・空き家の売却相談"
  description="相続した家・空き家の売却に関する無料相談はこちら。LINE・メールからお気軽にご連絡ください。秘密厳守・しつこい営業は一切いたしません。"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    label="ご相談"
    title="無料相談・お問い合わせ"
    sub="相続・空き家の売却に関するご相談は、LINE・メールフォームからお気軽にどうぞ。"
    image="/images/site/night.webp"
  />
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">


      <!-- LINEセクション（一番目立つ） -->
      <div class="mb-10 rounded-xl border-2 border-[#06C755] bg-white p-6 text-center shadow-sm md:p-8">
        <h2 class="mb-2 text-lg font-bold text-primary md:text-xl">
          LINEでのご相談（一番かんたん）
        </h2>
        <p class="mb-4 text-sm text-text-light">
          「空き家のミカタ」を友だち追加するだけ
        </p>

        <a
          href="https://line.arshe1719.workers.dev/auth/line?ref=hp"
          target="_blank"
          rel="noopener noreferrer"
          class="mb-4 inline-flex items-center justify-center gap-2 rounded-lg bg-[#06C755] px-10 py-4 text-lg font-bold text-white shadow-lg transition-all hover:bg-[#05b64d] hover:shadow-xl"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
          </svg>
          LINEで無料相談する
        </a>

        <!-- QRコード -->
        <img src="/images/line-qr.png" alt="空き家のミカタ LINE QRコード" class="mx-auto mb-3 rounded" style="width: 160px; height: 160px;" />

        <p class="text-sm text-text-light">トークで相談内容を送るだけ。24時間受付。</p>
      </div>

      <!-- メールアドレス -->
      <div class="mb-10 text-center">
        <p class="text-sm text-text-light">
          メールでのお問い合わせ: <a href="mailto:info.arshe@arshe-corp.com" class="font-bold text-primary underline hover:text-accent">info.arshe@arshe-corp.com</a>
        </p>
      </div>

      <!-- フォームセクション -->
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm md:p-8">
        <h2 class="mb-2 text-lg font-bold text-primary md:text-xl">
          フォームでのご相談（24時間受付）
        </h2>
        <p class="mb-6 text-sm text-text-light">
          以下のフォームにご記入ください。通常1営業日以内にご連絡いたします。
        </p>

        <form id="contact-form" class="space-y-6">
          <!-- お名前 -->
          <div>
            <label for="name" class="mb-1 block text-sm font-bold text-text">
              お名前 <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="例: 山田 太郎"
              class="w-full rounded-lg border border-border px-4 py-3 text-sm transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
            />
          </div>

          <!-- メールアドレス（返信先） -->
          <div>
            <label for="email" class="mb-1 block text-sm font-bold text-text">
              メールアドレス <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="例: yamada@example.com"
              class="w-full rounded-lg border border-border px-4 py-3 text-sm transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
            />
            <p class="mt-1 text-xs text-text-light">ご返信はメールでお送りします（お電話は差し上げません）</p>
          </div>

          <!-- 物件の種類 -->
          <div>
            <p class="mb-2 text-sm font-bold text-text">物件の種類</p>
            <div class="flex flex-wrap gap-4">
              {["マンション", "一戸建て", "土地", "その他"].map((type, i) => (
                <label class="flex items-center gap-2 text-sm">
                  <input
                    type="radio"
                    name="property_type"
                    value={type}
                    class="h-4 w-4 text-accent accent-accent"
                  />
                  {type}
                </label>
              ))}
            </div>
          </div>

          <!-- 物件の所在地 -->
          <div>
            <label for="location" class="mb-1 block text-sm font-bold text-text">
              物件の所在地（市区町村まで）
            </label>
            <input
              type="text"
              id="location"
              name="location"
              placeholder="例: 大阪市生野区"
              class="w-full rounded-lg border border-border px-4 py-3 text-sm transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
            />
          </div>

          <!-- ご相談内容 -->
          <div>
            <label for="message" class="mb-1 block text-sm font-bold text-text">
              ご相談内容
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="現在の状況やお悩みをお聞かせください"
              class="w-full rounded-lg border border-border px-4 py-3 text-sm transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none"
            ></textarea>
          </div>

          <!-- 送信ボタン -->
          <div class="text-center">
            <button
              type="submit"
              id="contact-submit-btn"
              class="inline-block w-full rounded-lg bg-accent px-8 py-4 text-lg font-bold text-white shadow-lg transition-all hover:bg-accent-light hover:shadow-xl sm:w-auto"
            >
              無料相談を申し込む
            </button>
            <p id="contact-form-error" class="mt-3 hidden text-sm font-bold text-red-500"></p>
          </div>
        </form>

        <!-- 送信完了メッセージ（成功時にフォームと差し替え） -->
        <div id="contact-form-done" class="hidden rounded-lg bg-primary/5 p-8 text-center">
          <p class="mb-2 text-lg font-bold text-primary">送信しました</p>
          <p class="text-sm leading-relaxed text-text">
            ご相談ありがとうございます。通常1営業日以内に、ご記入いただいたメールアドレスへご返信します。<br />
            お急ぎの場合は<a href="https://line.arshe1719.workers.dev/auth/line?ref=hp" target="_blank" rel="noopener noreferrer" class="font-bold text-accent underline">LINE</a>からもご相談いただけます。
          </p>
        </div>

        <script>
          const FORM_ENDPOINT = "https://line.arshe1719.workers.dev/api/forms/e713cdc0-17da-4830-89f4-5272886bdd7b/submit";
          const form = document.getElementById("contact-form") as HTMLFormElement;
          const errEl = document.getElementById("contact-form-error")!;
          const doneEl = document.getElementById("contact-form-done")!;
          const btn = document.getElementById("contact-submit-btn") as HTMLButtonElement;
          form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            errEl.classList.add("hidden");
            btn.disabled = true;
            btn.textContent = "送信中…";
            const fd = new FormData(form);
            const data = Object.fromEntries(fd.entries());
            try {
              const res = await fetch(FORM_ENDPOINT, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ data }),
              });
              const json = await res.json();
              if (!json.success) throw new Error(json.error || "送信に失敗しました");
              // @ts-ignore
              if (typeof gtag === "function") gtag("event", "form_submit", { event_category: "conversion", page_path: location.pathname });
              form.style.display = "none";
              doneEl.classList.remove("hidden");
            } catch (err) {
              errEl.textContent = (err instanceof Error ? err.message : "送信に失敗しました") + "。お手数ですがLINEまたはメールでご連絡ください。";
              errEl.classList.remove("hidden");
              btn.disabled = false;
              btn.textContent = "無料相談を申し込む";
            }
          });
        </script>
      </div>

      <!-- 安心メッセージ -->
      <div class="mt-8 rounded-lg bg-primary/5 p-5 text-center">
        <p class="text-sm leading-relaxed text-text">
          ご相談は<span class="font-bold text-primary">完全無料</span>です。しつこい営業は一切いたしません。<br class="hidden md:inline" /><span class="font-bold text-primary">秘密厳守</span>で対応します。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

      <p class="text-xs text-gray-400 mt-3">全{terms.length}語収録</p>
    </nav>

    <!-- 用語一覧（カテゴリ別） -->
    {
      categories.map((cat) => (
        <section id={`cat-${cat.replace(/[・]/g, "")}`} class="mb-12">
          <h2 class="text-xl font-bold text-gray-800 border-b-2 border-blue-400 pb-2 mb-6">
            {cat}
          </h2>
          <div class="space-y-6">
            {terms
              .filter((t) => t.category === cat)
              .map((term) => (
                <article
                  id={term.id}
                  class="border border-gray-200 rounded-lg p-5 hover:border-blue-300 transition"
                  itemscope
                  itemtype="https://schema.org/DefinedTerm"
                >
                  <div class="flex items-start justify-between gap-4 mb-2">
                    <div>
                      <h3
                        class="text-lg font-bold text-gray-900"
                        itemprop="name"
                      >
                        {term.name}
                      </h3>
                      <p class="text-xs text-gray-400">{term.kana}</p>
                    </div>
                    <span class="flex-shrink-0 text-xs bg-gray-100 text-gray-500 px-2 py-1 rounded">
                      {term.category}
                    </span>
                  </div>
                  <p
                    class="text-gray-700 text-sm leading-relaxed mb-3"
                    itemprop="description"
                  >
                    {term.definition}
                  </p>
                  <div class="flex flex-wrap gap-3 text-xs">
                    {term.source && (
                      <span class="text-gray-400">
                        <span class="font-semibold">根拠：</span>
                        {term.source}
                      </span>
                    )}
                    {term.relatedUrl && (
                      <a
                        href={term.relatedUrl}
                        class="text-blue-600 hover:underline font-medium"
                      >
                        → {term.relatedText}
                      </a>
                    )}
                  </div>
                </article>
              ))}
          </div>
        </section>
      ))
    }

    <!-- 執筆者情報 -->
    <div
      class="mt-12 border-t border-gray-200 pt-8"
      itemscope
      itemtype="https://schema.org/Person"
    >
      <p class="text-xs text-gray-500 mb-1">執筆・監修</p>
      <p class="font-bold text-gray-800" itemprop="name">
        八木 宏樹（やぎ ひろき）
      </p>
      <p class="text-sm text-gray-600" itemprop="jobTitle">
        宅地建物取引士・合同会社アルシェ代表
      </p>
      <p class="text-xs text-gray-500 mt-1">
        宅建業免許：大阪府知事(1)第65646号｜本店：大阪府大阪市生野区小路3-17-19
      </p>
      <p class="text-xs text-gray-400 mt-2">
        最終更新：2026年4月29日｜法令・制度は執筆時点の情報に基づきます。
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-10 bg-orange-50 border border-orange-200 rounded-xl p-6 text-center">
      <p class="text-lg font-bold text-gray-800 mb-2">
        「この物件、本当に売れるの？」と思ったら
      </p>
      <p class="text-sm text-gray-600 mb-4">
        用語を調べているだけでは解決しません。宅建士が無料で査定・相談対応します。
      </p>
      <a
        href="/contact"
        class="inline-block bg-orange-500 text-white font-bold px-8 py-3 rounded-lg hover:bg-orange-600 transition"
      >
        無料相談・査定を申し込む
      </a>
      <p class="text-xs text-gray-400 mt-2">
        LINE / 電話 / メール対応。秘密厳守・全国対応。
      </p>
    </div>
  </div>
</BaseLayout>

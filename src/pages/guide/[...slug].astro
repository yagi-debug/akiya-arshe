---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guide');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const LINE_URL = "https://lin.ee/9Fk9EUl";

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '売却ガイド', url: '/guide' },
  { name: entry.data.title, url: `/guide/${entry.id}/` },
];

// クラスター内部リンク（ピラー↔サブ記事の双方向リンク強化）
const allGuides = await getCollection('guide');

const clusterLabels: Record<string, string> = {
  'inheritance':      '相続不動産の出口戦略',
  'non-rebuildable':  '再建築不可物件',
  'shared-ownership': '共有持分トラブル',
  'akiya-tax':        '空き家の維持コストと税金',
  'accident':         '事故物件・心理的瑕疵',
  'wakeari':          '訳あり物件の買取・売却',
};

const currentCluster = entry.data.cluster;
const isPillarPage   = entry.data.isPillar === true;

// ピラーページ: 同クラスターのサブ記事（非ピラー）を最大8件表示
const clusterSubArticles = currentCluster
  ? allGuides
      .filter((g) => g.id !== entry.id && g.data.cluster === currentCluster && !g.data.isPillar)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
      .slice(0, 8)
  : [];

// サブ記事: ピラーページを先頭に、次いで同クラスターの他記事2件
const pillarArticle = currentCluster && !isPillarPage
  ? allGuides.find((g) => g.data.cluster === currentCluster && g.data.isPillar === true)
  : null;

// フォールバック: クラスター未設定記事はキーワードマッチ
const topicMap: Record<string, string[]> = {
  '事故物件': ['jiko', 'accident', 'shinriteki'],
  '再建築不可': ['saikenchifu', 'non-rebuildable'],
  '共有持分': ['kyouyuu', 'joint-ownership', 'dementia-coowner'],
  '相続アパート': ['souzoku-apart', 'inherited-apartment', 'nyukyosha-apart'],
  '空き家・固定資産税': ['akiya', 'vacancy', 'vacant', 'koteishisanzei'],
  '相続': ['souzoku', 'inheritance'],
  '底地・借地権': ['sokochi', 'shakuchiken'],
};
const currentTopic = Object.entries(topicMap).find(([, kws]) =>
  kws.some((kw) => entry.id.includes(kw))
)?.[0];

const relatedGuides = (() => {
  if (currentCluster && !isPillarPage) {
    // サブ記事: ピラー + 同クラスター2件
    const clusterPeers = allGuides
      .filter((g) => g.id !== entry.id && g.data.cluster === currentCluster && !g.data.isPillar)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
      .slice(0, 2);
    return pillarArticle ? [pillarArticle, ...clusterPeers] : clusterPeers;
  }
  // ピラーページまたはクラスター未設定: キーワードマッチ
  return allGuides
    .filter((g) => g.id !== entry.id)
    .sort((a, b) => {
      if (currentTopic) {
        const kws = topicMap[currentTopic];
        const aMatch = kws.some((kw) => a.id.includes(kw));
        const bMatch = kws.some((kw) => b.id.includes(kw));
        if (aMatch && !bMatch) return -1;
        if (!aMatch && bMatch) return 1;
      }
      return 0;
    })
    .slice(0, 3);
})();

// アイキャッチ: 記事内の最初の画像 → なければカテゴリ別写真（全記事に画像を保証）
const CLUSTER_IMG: Record<string, string> = {
  'inheritance':      '/images/site/cat-souzoku.webp',
  'non-rebuildable':  '/images/site/cat-saikenchifu.webp',
  'shared-ownership': '/images/site/cat-kyouyuu.webp',
  'akiya-tax':        '/images/site/cat-akiya-tax.webp',
  'accident':         '/images/site/cat-jiko.webp',
  'wakeari':          '/images/site/cat-wakeari.webp',
};
const TOPIC_IMG: Record<string, string> = {
  '事故物件': '/images/site/cat-jiko.webp',
  '再建築不可': '/images/site/cat-saikenchifu.webp',
  '共有持分': '/images/site/cat-kyouyuu.webp',
  '相続アパート': '/images/site/cat-souzoku.webp',
  '空き家・固定資産税': '/images/site/cat-akiya-tax.webp',
  '相続': '/images/site/cat-souzoku.webp',
  '底地・借地権': '/images/site/cat-wakeari.webp',
};
const inlineImgMatch = entry.body?.match(/<img[^>]+src="(\/images\/[^"]+)"/) || entry.body?.match(/!\[[^\]]*\]\((\/images\/[^)]+)\)/);
const inlineImg = inlineImgMatch ? inlineImgMatch[1] : null;
const categoryImg = (currentCluster && CLUSTER_IMG[currentCluster]) || (currentTopic && TOPIC_IMG[currentTopic]) || '/images/site/cat-wakeari.webp';
// 表示用: 記事内に画像がない記事だけ冒頭にカテゴリ写真を出す（重複回避）
const showEyecatch = !inlineImg;
// OGP/schema用: 記事内画像があればそれ、なければカテゴリ写真
const socialImg = inlineImg || categoryImg;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `https://akiya.arshe-corp.com/guide/${entry.id}/#article`,
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": `https://akiya.arshe-corp.com${inlineImg || categoryImg}`,
  "author": {
    "@type": "Person",
    "@id": "https://akiya.arshe-corp.com/about/hiroki#person",
    "name": "八木 宏樹",
    "jobTitle": "代表社員",
    "knowsAbout": ["訳あり不動産", "相続不動産売却", "空き家対策", "再建築不可物件", "共有持分"],
    "worksFor": {
      "@type": "Organization",
      "@id": "https://akiya.arshe-corp.com/#organization",
      "name": "空き家のミカタ",
    },
  },
  "datePublished": entry.data.publishDate,
  ...(entry.data.updatedDate ? { "dateModified": entry.data.updatedDate } : {}),
  "publisher": {
    "@type": "Organization",
    "@id": "https://akiya.arshe-corp.com/#organization",
    "name": "空き家のミカタ",
    "legalName": "合同会社アルシェ",
    "url": "https://akiya.arshe-corp.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://akiya.arshe-corp.com/logo.png",
      "width": 512,
      "height": 512,
    },
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "宅地建物取引業免許",
      "identifier": "大阪府知事(1)第65646号",
    },
  },
  ...(entry.data.wordCount ? { "wordCount": entry.data.wordCount } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://akiya.arshe-corp.com/guide/${entry.id}/`,
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", "blockquote", "table", ".speakable-highlight"],
  },
};

const faqSchema = entry.data.faqs && entry.data.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": entry.data.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
} : null;

const howToSchema = entry.data.howToSteps && entry.data.howToSteps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": entry.data.title,
  "description": entry.data.description,
  "step": entry.data.howToSteps.map((step, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "name": step.name,
    "text": step.text,
  })),
} : null;

const displayDate = entry.data.updatedDate || entry.data.publishDate;

---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  schema={articleSchema}
  faqSchema={faqSchema}
  howToSchema={howToSchema}
  breadcrumbs={breadcrumbs}
  ogType="article"
  ogImage={socialImg}
>
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <!-- 記事ヘッダー -->
    <header class="mb-8 border-b border-border pb-6">
      <h1 class="serif mb-4 text-2xl leading-relaxed text-primary md:text-3xl">
        {entry.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-text-light">
        <time datetime={displayDate}>
          {entry.data.updatedDate ? '更新日' : '公開日'}：{displayDate}
        </time>
        <span class="flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {entry.data.author}{entry.data.authorTitle ? `｜${entry.data.authorTitle}` : ''}
        </span>
      </div>
    </header>

    {showEyecatch && (
      <div class="mb-8 overflow-hidden rounded-2xl">
        <img src={categoryImg} alt="" width="1200" height="675" fetchpriority="high"
          class="h-44 w-full object-cover md:h-64" />
      </div>
    )}

    <!-- 記事本文 -->
    <div class="prose prose-lg max-w-none
      prose-headings:text-primary prose-headings:font-black
      prose-h2:mt-12 prose-h2:mb-5 prose-h2:rounded-r-xl prose-h2:border-l-4 prose-h2:border-accent prose-h2:bg-accent/5 prose-h2:py-2.5 prose-h2:pl-4 prose-h2:pr-3 prose-h2:text-xl
      prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-lg
      prose-p:leading-relaxed prose-p:text-text
      prose-li:text-text
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-blockquote:rounded-r-xl prose-blockquote:border-l-4 prose-blockquote:border-primary/30 prose-blockquote:bg-white prose-blockquote:py-1 prose-blockquote:not-italic
      prose-table:text-sm
      prose-th:bg-bg-dark prose-th:px-4 prose-th:py-2
      prose-td:border prose-td:border-border prose-td:px-4 prose-td:py-2
    ">
      <Content />
    </div>
  </article>

  <!-- 記事内CTA: 査定主導＋直接LINE（最強コンバーターのAI査定へ送りつつ、直接LINEも残す） -->
  <aside class="mx-auto max-w-3xl px-4 pb-8">
    <div class="rounded-xl border border-accent/40 bg-accent/5 p-5 text-center md:p-6">
      <p class="mb-1 text-lg font-bold text-text md:text-xl">あなたの物件、いくらで売れる？</p>
      <p class="mb-5 text-sm leading-relaxed text-text-light">
        この記事は一般的な内容です。実際の買取価格は物件の状態や権利関係で変わります。
        まずは<strong class="text-text">無料のAI査定</strong>で概算を確認できます（約60秒・個人情報の入力不要）。
      </p>
      <a
        href="/satei"
        class="mb-3 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-accent px-8 py-4 text-base font-bold text-white shadow transition-all hover:opacity-90 hover:shadow-lg sm:w-auto"
      >
        無料AI査定で概算価格を見る →
      </a>
      <p class="mb-1 text-xs text-text-light">または、写真・住所を送って直接相談</p>
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-[#06C755] px-7 py-3 text-base font-bold text-[#06C755] transition-all hover:bg-[#06C755]/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
        </svg>
        LINEで無料相談する
      </a>
      <p class="mt-4 text-xs leading-relaxed text-text-light">
        相談だけでも大丈夫です。しつこい勧誘・営業電話は一切いたしません。<br class="hidden sm:block" />
        合同会社アルシェ代表・八木宏樹が原則24時間以内にお返事します（相談無料・秘密厳守・全国対応）。
      </p>
    </div>
  </aside>

  <!-- 著者バイオ（E-E-A-T） -->
  <aside class="mx-auto max-w-3xl px-4 pb-6">
    <a href="/about/hiroki" class="block rounded-lg border border-border bg-bg-dark p-5 transition-all hover:border-accent hover:shadow-md">
      <div class="flex gap-4 items-start">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-accent flex items-center justify-center text-white text-xl font-bold">八</div>
        <div class="flex-1">
          <p class="text-xs font-semibold text-accent mb-0.5">執筆・監修</p>
          <p class="font-bold text-text text-base">八木 宏樹（Hiroki Yagi）</p>
          <p class="text-sm text-text-light mb-2">合同会社アルシェ 代表社員（宅建業免許: 大阪府知事(1)第65646号）</p>
          <p class="text-sm text-text leading-relaxed">相続アパート・再建築不可・事故物件・共有持分・空き家など「訳あり不動産」の直接買取専門家。「どこにも断られた物件でも諦めない」をモットーに全国対応で現金買取。</p>
          <p class="mt-2 text-xs text-accent font-medium">→ 詳細プロフィールを見る</p>
        </div>
      </div>
    </a>
  </aside>

  <!-- ピラーページ: クラスター内サブ記事カードグリッド -->
  {isPillarPage && currentCluster && clusterSubArticles.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-8">
      <div class="mb-5 rounded-xl border-2 border-accent/30 bg-accent/5 p-1">
        <h2 class="mb-4 px-3 pt-3 text-lg font-bold text-text">
          このガイドで解説しているトピック
          <span class="ml-2 rounded-full bg-accent/15 px-2 py-0.5 text-sm font-medium text-accent">
            {clusterLabels[currentCluster]}
          </span>
        </h2>
        <div class="grid gap-3 px-3 pb-3 sm:grid-cols-2">
          {clusterSubArticles.map((g) => (
            <a
              href={`/guide/${g.id}`}
              class="flex items-start gap-3 rounded-lg border border-border bg-white p-4 transition-all hover:border-accent hover:shadow-md"
            >
              <span class="mt-0.5 flex-shrink-0 rounded-full bg-accent/10 p-1.5 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-bold text-text leading-snug">{g.data.title}</p>
                <p class="mt-1 text-xs text-text-light line-clamp-2">{g.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- サブ記事: ピラーへの戻りリンク -->
  {!isPillarPage && pillarArticle && (
    <section class="mx-auto max-w-3xl px-4 pb-4">
      <a
        href={`/guide/${pillarArticle.id}`}
        class="flex items-center gap-3 rounded-lg border border-accent/40 bg-accent/5 p-4 transition-all hover:border-accent hover:shadow-md"
      >
        <span class="flex-shrink-0 rounded-full bg-accent p-1.5 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18" />
          </svg>
        </span>
        <div>
          <p class="text-xs font-semibold text-accent mb-0.5">
            {currentCluster ? clusterLabels[currentCluster] : ''} — 完全ガイド
          </p>
          <p class="text-sm font-bold text-text leading-snug">{pillarArticle.data.title}</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto h-5 w-5 flex-shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </section>
  )}

  <!-- 関連ガイド -->
  {relatedGuides.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-8">
      <h2 class="mb-4 text-xl font-bold text-text">関連する売却ガイド</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {relatedGuides.map((guide) => (
          <a
            href={`/guide/${guide.id}`}
            class="block rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
          >
            <h3 class="mb-2 text-base font-bold text-text">{guide.data.title}</h3>
            <p class="text-sm text-text-light line-clamp-2">{guide.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

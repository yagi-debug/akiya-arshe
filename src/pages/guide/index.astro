---
import { getCollection } from 'astro:content';
import PageHero from "../../components/PageHero.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '売却ガイド', url: '/guide' },
];

const guides = await getCollection('guide', ({ data }) => !data.noindex);
// publishDate降順
const sortedGuides = guides.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title="不動産売却ガイド｜相続・空き家・訳あり物件の買取を宅建業者が解説"
  description="相続した不動産の売却方法、空き家の処分、訳あり物件の買取など、宅建業者がわかりやすく解説するガイド記事一覧です。"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    label="売却ガイド"
    title="不動産売却ガイド"
    sub="相続・空き家・訳あり物件の買取まで、宅建業者がやさしく解説します。"
    image="/images/site/hero2.webp"
  />
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">


      <!-- ファーストビューCTA：/guide/ 18PV→0CV対策 -->
      <div class="mb-10 rounded-xl bg-primary/5 border border-primary/20 p-5 md:p-6">
        <p class="mb-3 text-center text-sm font-bold text-primary md:text-base">
          記事を読む前でも、お気軽にご相談いただけます
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="https://line.arshe1719.workers.dev/auth/line?ref=hp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#06C755] px-6 py-3 text-sm font-bold text-white shadow transition-all hover:bg-[#05b64d] hover:shadow-md md:text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
            </svg>
            LINEで無料相談する
          </a>
          <a
            href="tel:06-7509-5696"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-primary/30 px-6 py-3 text-sm font-bold text-primary transition-all hover:bg-primary/5 md:text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            電話で相談する
          </a>
        </div>
        <p class="mt-2 text-center text-xs text-text-light">相談無料・秘密厳守・宅建業者が対応</p>
      </div>

      <div class="space-y-6">
        {sortedGuides.map((guide) => (
          <a
            href={`/guide/${guide.id}`}
            class="block rounded-xl border border-border bg-white p-6 shadow-sm transition-all hover:border-accent hover:shadow-md"
          >
            <h2 class="mb-2 text-lg font-bold text-primary md:text-xl">
              {guide.data.title}
            </h2>
            <p class="mb-3 text-sm leading-relaxed text-text-light line-clamp-2">
              {guide.data.description}
            </p>
            <div class="flex items-center gap-3 text-xs text-text-light">
              <span>{guide.data.updatedDate || guide.data.publishDate}</span>
              <span>|</span>
              <span>{guide.data.author}（{guide.data.authorTitle}）</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

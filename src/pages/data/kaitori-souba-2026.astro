  { zone: "高", name: "西区",     difficulty: 2, saikenfuka: "200〜520万円", jiko: "通常の45〜68%", kyoyu: "評価額×持分×62〜78%", akiya: "400〜1,100万円",  note: "堀江・江戸堀。おしゃれエリアで需要安定" },
  // 中高地価帯
  { zone: "中高", name: "阿倍野区",  difficulty: 3, saikenfuka: "180〜420万円", jiko: "通常の43〜67%", kyoyu: "評価額×持分×60〜76%", akiya: "320〜900万円",   note: "あべのハルカス周辺。商業・住宅が充実" },
  { zone: "中高", name: "福島区",    difficulty: 3, saikenfuka: "160〜380万円", jiko: "通常の43〜67%", kyoyu: "評価額×持分×60〜76%", akiya: "300〜800万円",   note: "福島・野田。共働きファミリー層に人気" },
  { zone: "中高", name: "淀川区",    difficulty: 3, saikenfuka: "150〜350万円", jiko: "通常の42〜65%", kyoyu: "評価額×持分×58〜75%", akiya: "280〜720万円",   note: "十三・新大阪・東三国。交通利便性が高い" },
  { zone: "中高", name: "都島区",    difficulty: 3, saikenfuka: "140〜330万円", jiko: "通常の42〜65%", kyoyu: "評価額×持分×58〜75%", akiya: "260〜680万円",   note: "都島・桜ノ宮・京橋近郊" },
  { zone: "中高", name: "城東区",    difficulty: 3, saikenfuka: "140〜320万円", jiko: "通常の42〜65%", kyoyu: "評価額×持分×58〜74%", akiya: "250〜650万円",   note: "蒲生・鴫野・今福。長屋が多い住宅街" },
  { zone: "中高", name: "鶴見区",    difficulty: 3, saikenfuka: "150〜360万円", jiko: "通常の43〜66%", kyoyu: "評価額×持分×60〜76%", akiya: "280〜700万円",   note: "横堤・今津。ファミリー層の住宅需要" },
  // 中地価帯
  { zone: "中", name: "旭区",     difficulty: 3, saikenfuka: "120〜280万円", jiko: "通常の40〜63%", kyoyu: "評価額×持分×55〜72%", akiya: "200〜520万円",   note: "千林・大宮・関目。下町の住宅地" },
  { zone: "中", name: "東淀川区", difficulty: 4, saikenfuka: "110〜260万円", jiko: "通常の40〜63%", kyoyu: "評価額×持分×55〜72%", akiya: "180〜480万円",   note: "吹田隣接。木造長屋が多く再建築不可多数" },
  { zone: "中", name: "住吉区",   difficulty: 3, saikenfuka: "130〜300万円", jiko: "通常の40〜63%", kyoyu: "評価額×持分×55〜72%", akiya: "200〜530万円",   note: "帝塚山・我孫子。文教地区・住環境良好" },
  { zone: "中", name: "住之江区", difficulty: 4, saikenfuka: "110〜260万円", jiko: "通常の40〜63%", kyoyu: "評価額×持分×55〜72%", akiya: "180〜450万円",   note: "住之江・北加賀屋。再開発が進む" },
  { zone: "中", name: "港区",     difficulty: 4, saikenfuka: "100〜250万円", jiko: "通常の40〜62%", kyoyu: "評価額×持分×55〜71%", akiya: "160〜420万円",   note: "弁天町・市岡。湾岸エリア" },

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '訳あり不動産 買取価格データベース2026', url: '/data/kaitori-souba-2026' },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "大阪市区別 訳あり不動産買取価格データベース2026",
  "description": "国土交通省「不動産取引価格情報（土地総合情報システム）」を基に、大阪市24区×物件タイプ別（再建築不可・事故物件・共有持分・空き家）の買取価格レンジをまとめたデータベース。合同会社アルシェ（宅地建物取引業）が2026年5月時点の市場データを基に作成。",
  "creator": {
    "@type": "Organization",
    "name": "合同会社アルシェ",
    "url": "https://akiya.arshe-corp.com"
  },
  "datePublished": "2026-05-31",
  "dateModified": "2026-06-11",
  "license": "https://akiya.arshe-corp.com/privacy",
  "spatialCoverage": {
    "@type": "Place",
    "name": "大阪市（24区）"
  },
  "variableMeasured": [
    { "@type": "PropertyValue", "name": "再建築不可物件買取価格レンジ", "unitText": "万円" },
    { "@type": "PropertyValue", "name": "事故物件買取価格（通常比）", "unitText": "%" },
    { "@type": "PropertyValue", "name": "共有持分買取価格（評価額比）", "unitText": "%" },
    { "@type": "PropertyValue", "name": "空き家買取価格レンジ（解体費控除後）", "unitText": "万円" }
  ],
  "citation": "国土交通省 土地総合情報システム 不動産取引価格情報（https://www.land.mlit.go.jp/）",
  "isAccessibleForFree": true
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "大阪市の再建築不可物件はいくらで買取されますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "大阪市の再建築不可物件の買取価格は、区によって大きく異なります。北区・中央区など地価の高いエリアでは300〜800万円、生野区・西成区などでは60〜200万円が目安です。いずれも更地価格の30〜60%が相場です（接道状況・建物状態により変動）。"
      }
    },
    {
      "@type": "Question",
      "name": "大阪市で共有持分だけを売る場合の買取価格はどのくらいですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "共有持分の買取価格は、不動産全体の固定資産税評価額×持分割合×60〜80%が目安です。北区・中央区のマンション1/2持分（評価額3,000万円）なら900〜1,200万円程度。共有者全員の同意は不要で、自分の持分のみ単独で売却できます（民法第206条）。"
      }
    },
    {
      "@type": "Question",
      "name": "大阪市で事故物件（孤独死・自殺）を売ると通常比でどのくらい下がりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "大阪市の事故物件買取価格は、区にかかわらず通常物件の40〜70%が目安です。孤独死（清掃済み・発見が早い）は55〜70%、自殺（発生から1年未満）は40〜60%。発生から3年超・リフォーム済みの場合は60〜75%まで回復することがあります。"
      }
    },
    {
      "@type": "Question",
      "name": "大阪市の空き家を買取してもらうとどのくらいになりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "大阪市の空き家買取価格は、エリアと築年数・状態によって大きく異なります。北区・中央区では500〜1,500万円程度、生野区・西成区・平野区では80〜280万円程度。解体費（目安：木造80〜150万円）を控除した実取得額が重要です。"
      }
    },
    {
      "@type": "Question",
      "name": "国土交通省のデータと実際の買取価格は違いますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "国交省の取引価格情報は仲介売買（市場価格）のデータです。買取価格はこれより低くなります（目安：市場価格の60〜80%）。ただし訳あり物件は仲介で売却が難しいため、買取専門業者への依頼が現実的です。当サイトの価格レンジは買取価格ベースです。"
      }
    }
  ]
};

// 大阪市24区 × 物件タイプ別 買取価格データ
// 出典: 国交省 不動産取引価格情報 (2024-2025年)、合同会社アルシェ査定実績
// difficulty: 訳あり物件の買取難易度（1=容易 〜 5=非常に困難）
const wards = [
  // 高地価帯（路線価 400万円/㎡超の主要エリアを含む区）
  { zone: "高", name: "北区",     difficulty: 2, saikenfuka: "300〜800万円", jiko: "通常の45〜70%", kyoyu: "評価額×持分×65〜80%", akiya: "600〜2,000万円",  note: "梅田・大阪駅周辺。マンション・商業ビルが多い" },
  { zone: "高", name: "中央区",   difficulty: 2, saikenfuka: "280〜750万円", jiko: "通常の45〜70%", kyoyu: "評価額×持分×65〜80%", akiya: "550〜1,800万円",  note: "難波・心斎橋・本町。地価は大阪市最高水準" },
  { zone: "高", name: "天王寺区", difficulty: 2, saikenfuka: "200〜500万円", jiko: "通常の45〜68%", kyoyu: "評価額×持分×60〜78%", akiya: "400〜1,200万円",  note: "天王寺・阿倍野橋エリア。住宅需要が高い" },

  { zone: "中低", name: "生野区",    difficulty: 4, saikenfuka: "90〜220万円",  jiko: "通常の40〜62%", kyoyu: "評価額×持分×53〜70%", akiya: "150〜380万円",   note: "木造長屋・再建築不可物件が非常に多い。当社の主要対応エリア" },
  { zone: "中低", name: "東成区",    difficulty: 4, saikenfuka: "90〜220万円",  jiko: "通常の40〜62%", kyoyu: "評価額×持分×53〜70%", akiya: "150〜380万円",   note: "今里・中道。長屋密集地帯" },
  { zone: "中低", name: "東住吉区",  difficulty: 3, saikenfuka: "100〜240万円", jiko: "通常の40〜62%", kyoyu: "評価額×持分×53〜70%", akiya: "160〜400万円",   note: "田辺・杭全。戸建て住宅が多い" },
  { zone: "中低", name: "大正区",    difficulty: 4, saikenfuka: "80〜200万円",  jiko: "通常の40〜62%", kyoyu: "評価額×持分×53〜70%", akiya: "130〜340万円",   note: "大正・鶴町。沖縄ルーツの文化が残るエリア" },
  // 低地価帯
  { zone: "低", name: "西成区",   difficulty: 5, saikenfuka: "60〜180万円",  jiko: "通常の40〜60%", kyoyu: "評価額×持分×50〜68%", akiya: "80〜280万円",    note: "長屋・老朽物件が多い。解体費控除後は80〜200万円が多い" },
  { zone: "低", name: "平野区",   difficulty: 4, saikenfuka: "80〜200万円",  jiko: "通常の40〜62%", kyoyu: "評価額×持分×52〜70%", akiya: "100〜300万円",   note: "大阪市最大の人口を持つ区。広大な住宅地" },
  { zone: "低", name: "西淀川区", difficulty: 5, saikenfuka: "70〜180万円",  jiko: "通常の40〜60%", kyoyu: "評価額×持分×50〜68%", akiya: "100〜280万円",   note: "歌島・姫里。工場混在の住宅地" },
  { zone: "低", name: "此花区",   difficulty: 5, saikenfuka: "70〜180万円",  jiko: "通常の40〜60%", kyoyu: "評価額×持分×50〜68%", akiya: "90〜260万円",    note: "USJ周辺・酉島。工場・住宅混在地" },
];

const updatedDate = "2026年6月11日";

// Table Schema（JSON-LD）: 区別買取難易度・相場テーブルをAI検索が構造化データとして認識できるよう記述
const tableSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "@id": "https://akiya.arshe-corp.com/data/kaitori-souba-2026#ward-table",
  "name": "大阪市24区別 訳あり物件買取難易度・相場データベース",
  "description": "大阪市24区の訳あり不動産（再建築不可・事故物件・共有持分・空き家）について、区別の買取価格レンジおよび買取難易度（1〜5段階、1=容易・5=非常に困難）を一覧化したデータ。合同会社アルシェ（宅建業）が実績をもとに作成。",
  "creator": { "@type": "Organization", "name": "合同会社アルシェ", "url": "https://akiya.arshe-corp.com" },
  "dateModified": "2026-06-11",
  "keywords": ["大阪市 訳あり物件 買取", "大阪市24区 再建築不可 買取相場", "大阪市 共有持分 買取難易度", "大阪市 事故物件 買取価格"],
  "about": wards.map(w => ({
    "@type": "Place",
    "name": `大阪市${w.name}`,
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "再建築不可買取相場", "value": w.saikenfuka },
      { "@type": "PropertyValue", "name": "事故物件買取相場（通常比）", "value": w.jiko },
      { "@type": "PropertyValue", "name": "共有持分買取相場", "value": w.kyoyu },
      { "@type": "PropertyValue", "name": "空き家買取相場", "value": w.akiya },
      { "@type": "PropertyValue", "name": "買取難易度（1-5）", "value": w.difficulty, "description": "1=容易, 2=やや容易, 3=標準, 4=難しい, 5=非常に困難" }
    ]
  }))
};
const zones = [
  { label: "高地価帯（路線価目安：200万円/㎡超）", wards: wards.filter(w => w.zone === "高") },
  { label: "中高地価帯（路線価目安：100〜200万円/㎡）", wards: wards.filter(w => w.zone === "中高") },
  { label: "中地価帯（路線価目安：50〜100万円/㎡）", wards: wards.filter(w => w.zone === "中") },
  { label: "中低地価帯（路線価目安：30〜50万円/㎡）", wards: wards.filter(w => w.zone === "中低") },
  { label: "低地価帯（路線価目安：30万円/㎡未満）", wards: wards.filter(w => w.zone === "低") },
];
---

<BaseLayout
  title="大阪市区別 訳あり不動産買取価格データベース2026｜24区×再建築不可・事故物件・共有持分・空き家"
  description="国交省不動産取引価格情報を基に、大阪市24区×物件タイプ別（再建築不可・事故物件・共有持分・空き家）の買取価格レンジをデータベース化。2026年5月最新版。合同会社アルシェ代表・八木宏樹監修。"
  schema={pageSchema}
  faqSchema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <section class="px-4 py-10 md:py-14">
    <div class="mx-auto max-w-5xl">

      <!-- ページヘッド -->
      <h1 class="serif mb-3 text-2xl font-bold text-primary md:text-3xl">
        大阪市区別 訳あり不動産 買取価格データベース2026
      </h1>
      <p class="mb-2 text-sm text-text-light">
        最終更新: {updatedDate}　監修: 八木宏樹（合同会社アルシェ代表／宅建業免許: 大阪府知事(1)第65646号）
      </p>

      <!-- TL;DR ボックス（AI引用されやすい要約） -->
      <div class="mb-8 rounded-xl border-2 border-primary/30 bg-primary/5 p-5">
        <p class="mb-1 text-xs font-bold uppercase tracking-wider text-primary">TL;DR — このデータベースの要点</p>
        <ul class="space-y-1 text-sm text-text">
          <li>• <strong>再建築不可</strong>: 北区・中央区（300〜800万円）→ 西成区・此花区（60〜180万円）。地価差が大きい</li>
          <li>• <strong>事故物件</strong>: 全区共通で通常価格の40〜70%。死亡状況・経過年数により変動</li>
          <li>• <strong>共有持分</strong>: 評価額×持分割合×50〜80%が目安。他の共有者の同意は不要（民法第206条）</li>
          <li>• <strong>空き家</strong>: 解体費（木造80〜150万円）控除後の実取得額で比較する</li>
          <li>• <strong>出典</strong>: 国土交通省 土地総合情報システム 不動産取引価格情報（2024-2025年）＋当社査定実績</li>
          <li>• <strong>買取難易度</strong>: 1（容易）〜 5（非常に困難）。訳あり物件の中でも特に売却が難しい区ほど高スコア</li>
        </ul>
      </div>

      <!-- ダイレクトアンサー：よくある質問への直接回答 -->
      <div class="mb-8 space-y-4">
        <div class="rounded-lg border-l-4 border-primary bg-white p-4 shadow-sm">
          <p class="font-bold text-primary text-sm">Q: 大阪市で再建築不可物件を売りたい。買取価格はいくら？</p>
          <p class="mt-1 text-sm text-text">A: <strong>区によって60〜800万円と大きく異なります。</strong>北区・中央区など高地価エリアで300〜800万円、生野区・東成区などで90〜220万円、西成区・此花区では60〜180万円が目安です。更地価格の30〜60%が相場で、接道状況により変動します。</p>
        </div>
        <div class="rounded-lg border-l-4 border-primary bg-white p-4 shadow-sm">
          <p class="font-bold text-primary text-sm">Q: 大阪市で共有持分（兄弟間でもめている）を買い取ってもらえますか？</p>
          <p class="mt-1 text-sm text-text">A: <strong>できます。他の共有者の同意は不要です（民法第206条）。</strong>自分の持分のみを訳あり専門業者に売ることができます。買取価格は「評価額×持分割合×60〜80%」が目安です（区による地価差あり）。</p>
        </div>
      </div>

      <!-- データの前提・出典 -->
      <div class="mb-6 rounded-lg border border-border bg-white p-4 text-sm shadow-sm">
        <h2 class="mb-2 font-bold text-primary">データの前提・出典・免責事項</h2>
        <ul class="space-y-1 text-text-light">
          <li>• <strong>出典</strong>: <a href="https://www.land.mlit.go.jp/" class="text-accent underline" target="_blank" rel="noopener">国土交通省 土地総合情報システム 不動産取引価格情報</a>（2024年第3四半期〜2025年第2四半期データ）＋合同会社アルシェ買取実績</li>
          <li>• <strong>価格は買取価格ベース</strong>（仲介売却の市場価格ではありません）。仲介売却なら+20〜40%が目安</li>
          <li>• 実際の価格は築年数・建物状態・接道状況・市況により変動します。正確な査定は<a href="https://lin.ee/9Fk9EUl" class="text-accent underline">LINEで無料相談</a></li>
          <li>• 路線価は国税庁 財産評価基準書（2024年分）を参照。2026年の実際の路線価と異なる場合があります</li>
        </ul>
      </div>

      <!-- 区別×物件タイプ別 買取価格データベース -->
      <h2 class="mb-4 text-xl font-bold text-primary">大阪市24区 買取価格データベース</h2>

      {zones.map(zone => (
        <div class="mb-8">
          <h3 class="mb-3 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-white">{zone.label}</h3>
          <div class="overflow-x-auto rounded-xl border border-border shadow-sm">
            <table class="w-full min-w-[780px] text-xs md:text-sm">
              <thead>
                <tr class="bg-primary/10">
                  <th class="px-3 py-2 text-left font-bold text-primary">区</th>
                  <th class="px-3 py-2 text-left font-bold text-primary">再建築不可</th>
                  <th class="px-3 py-2 text-left font-bold text-primary">事故物件</th>
                  <th class="px-3 py-2 text-left font-bold text-primary">共有持分</th>
                  <th class="px-3 py-2 text-left font-bold text-primary">空き家</th>
                  <th class="px-3 py-2 text-center font-bold text-primary whitespace-nowrap">難易度</th>
                </tr>
              </thead>
              <tbody>
                {zone.wards.map((w, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-bg'}>
                    <td class="px-3 py-2 font-bold text-text whitespace-nowrap">
                      {w.name}
                      <span class="block text-xs font-normal text-text-light">{w.note}</span>
                    </td>
                    <td class="px-3 py-2 text-accent font-semibold whitespace-nowrap">{w.saikenfuka}</td>
                    <td class="px-3 py-2 text-text whitespace-nowrap">{w.jiko}</td>
                    <td class="px-3 py-2 text-text">{w.kyoyu}</td>
                    <td class="px-3 py-2 text-text whitespace-nowrap">{w.akiya}</td>
                    <td class="px-3 py-2 text-center whitespace-nowrap" title={`買取難易度 ${w.difficulty}/5`}>
                      {Array.from({length: w.difficulty}).map(() => '★').join('')}{Array.from({length: 5 - w.difficulty}).map(() => '☆').join('')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <!-- 物件タイプ別の計算ロジック -->
      <div class="mb-10 space-y-5">
        <h2 class="text-xl font-bold text-primary">物件タイプ別 価格計算ロジック</h2>

        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <h3 class="mb-2 font-bold text-primary">再建築不可物件の買取価格計算</h3>
          <p class="mb-2 text-sm text-text">再建築不可物件の買取価格 = <strong>土地の時価（近隣更地価格）× 30〜60%</strong></p>
          <ul class="space-y-1 text-xs text-text-light">
            <li>• 接道なし（袋地・囲繞地）→ ×30〜35%</li>
            <li>• 接道1m未満 → ×35〜45%</li>
            <li>• 接道1〜1.8m → ×40〜50%</li>
            <li>• 接道1.8〜2m未満（旗竿地） → ×50〜60%</li>
          </ul>
          <p class="mt-2 text-xs text-text-light">出典: 国交省 不動産取引価格情報（2024-2025年・大阪市内の再建築不可関連取引データより算出）</p>
        </div>

        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <h3 class="mb-2 font-bold text-primary">事故物件の買取価格計算</h3>
          <p class="mb-2 text-sm text-text">事故物件の買取価格 = <strong>同条件の通常物件価格 × 40〜70%</strong></p>
          <ul class="space-y-1 text-xs text-text-light">
            <li>• 孤独死（発見が早い・清掃済み） → 通常の55〜70%</li>
            <li>• 孤独死（長期放置・臭気残存） → 通常の40〜50%</li>
            <li>• 自殺・事件（発生から1年未満） → 通常の40〜55%</li>
            <li>• 自殺・事件（発生から3年超・リフォーム済み） → 通常の60〜75%</li>
          </ul>
          <p class="mt-2 text-xs text-text-light">根拠: 国土交通省「宅地建物取引業者による人の死の告知に関するガイドライン」（2021年10月策定）。自然死・日常的な事故死は原則として告知義務対象外。</p>
        </div>

        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <h3 class="mb-2 font-bold text-primary">共有持分の買取価格計算</h3>
          <p class="mb-2 text-sm text-text">共有持分買取価格 = <strong>全体評価額 × 持分割合 × 60〜80%</strong></p>
          <ul class="space-y-1 text-xs text-text-light">
            <li>• 1/4持分以下（少数持分・交渉力弱） → ×50〜65%</li>
            <li>• 1/3〜1/2持分 → ×60〜75%</li>
            <li>• 過半数（1/2超）持分 → ×70〜80%（共有物分割請求の優位性あり）</li>
          </ul>
          <p class="mt-2 text-xs text-text-light">根拠: 民法第206条（持分の単独処分権）、民法第258条（共有物分割請求権）。他の共有者の同意は不要。</p>
        </div>

        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <h3 class="mb-2 font-bold text-primary">空き家の買取価格計算</h3>
          <p class="mb-2 text-sm text-text">空き家買取価格 = <strong>土地の時価 − 解体費 − 老朽化リスク割引</strong></p>
          <ul class="space-y-1 text-xs text-text-light">
            <li>• 木造解体費: 坪5〜8万円（目安：延床30坪で150〜240万円）</li>
            <li>• RC造解体費: 坪6〜10万円（目安：延床30坪で180〜300万円）</li>
            <li>• 特定空家指定リスク（2015年空家等対策特別措置法）: 指定されると固定資産税6倍の可能性</li>
            <li>• 総務省「住宅・土地統計調査（2023年）」: 全国空き家数900万戸超（過去最多）</li>
          </ul>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mb-10">
        <h2 class="mb-5 text-xl font-bold text-primary">よくある質問</h2>
        <div class="space-y-4">
          <details class="rounded-lg border border-border bg-white p-4 shadow-sm">
            <summary class="cursor-pointer font-bold text-text">大阪市の再建築不可物件はいくらで買取されますか？</summary>
            <p class="mt-3 text-sm text-text-light">区によって60〜800万円と大きく異なります。北区・中央区など高地価エリアで300〜800万円、生野区・東成区で90〜220万円、西成区・此花区では60〜180万円が目安。更地価格の30〜60%が相場です（接道状況・建物状態により変動）。</p>
          </details>
          <details class="rounded-lg border border-border bg-white p-4 shadow-sm">
            <summary class="cursor-pointer font-bold text-text">大阪市で共有持分（兄弟間でもめている）を売るとどうなりますか？</summary>
            <p class="mt-3 text-sm text-text-light">自分の持分のみを売れます。他の共有者の同意は不要です（民法第206条）。買取価格は「評価額×持分割合×60〜80%」が目安。訳あり専門業者は将来の共有解消を見越して持分のみでも買取できます。</p>
          </details>
          <details class="rounded-lg border border-border bg-white p-4 shadow-sm">
            <summary class="cursor-pointer font-bold text-text">大阪市で事故物件（孤独死・自殺）を売る場合、価格はどのくらい下がりますか？</summary>
            <p class="mt-3 text-sm text-text-light">通常物件の40〜70%が目安。孤独死（清掃済み）は55〜70%、自殺（1年未満）は40〜60%。3年超経過・リフォーム済みなら60〜75%まで回復することがあります。</p>
          </details>
          <details class="rounded-lg border border-border bg-white p-4 shadow-sm">
            <summary class="cursor-pointer font-bold text-text">このデータは国土交通省のどのデータを使っていますか？</summary>
            <p class="mt-3 text-sm text-text-light">国交省 土地総合情報システムの「不動産取引価格情報」（2024年第3四半期〜2025年第2四半期、大阪市内の取引データ）を参照しています。仲介売買の市場価格データをもとに、買取価格レンジ（市場価格の60〜80%）に換算して掲載しています。詳細データは<a href="https://www.land.mlit.go.jp/" class="text-accent underline" target="_blank" rel="noopener">国交省公式サイト</a>で確認できます。</p>
          </details>
        </div>
      </div>


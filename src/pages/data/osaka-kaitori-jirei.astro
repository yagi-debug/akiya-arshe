  "再建築不可": Math.round(cases.filter(c => c.type === "再建築不可").reduce((s, c) => s + c.days, 0) / cases.filter(c => c.type === "再建築不可").length),
  "事故物件": Math.round(cases.filter(c => c.type === "事故物件").reduce((s, c) => s + c.days, 0) / cases.filter(c => c.type === "事故物件").length),
  "共有持分": Math.round(cases.filter(c => c.type === "共有持分").reduce((s, c) => s + c.days, 0) / cases.filter(c => c.type === "共有持分").length),
  "相続アパート": Math.round(cases.filter(c => c.type === "相続アパート").reduce((s, c) => s + c.days, 0) / cases.filter(c => c.type === "相続アパート").length),
  "空き家": Math.round(cases.filter(c => c.type === "空き家").reduce((s, c) => s + c.days, 0) / cases.filter(c => c.type === "空き家").length),
};


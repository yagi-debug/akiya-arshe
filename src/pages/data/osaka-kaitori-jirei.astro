---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '大阪市 訳あり物件 買取事例データベース', url: '/data/osaka-kaitori-jirei' },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "大阪市 訳あり物件 買取参考事例データベース",
  "description": "合同会社アルシェ（空き家のミカタ・宅地建物取引業）が、大阪市内でよくあるご相談と公的相場データをもとに構成した訳あり物件の参考事例60件以上。再建築不可・事故物件・共有持分・相続アパート・空き家の区別・物件種別・築年数・訳あり理由・買取価格帯・解決日数を匿名化して公開。大阪市生野区・平野区・西成区・城東区・鶴見区など24区の参考データ。",
  "creator": {
    "@type": "Organization",
    "name": "合同会社アルシェ",
    "url": "https://akiya.arshe-corp.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "areaServed": "JP-27"
    }
  },
  "datePublished": "2026-06-15",
  "dateModified": "2026-06-15",
  "license": "https://akiya.arshe-corp.com/privacy",
  "spatialCoverage": {
    "@type": "Place",
    "name": "大阪市（24区全域）",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "大阪府",
      "addressLocality": "大阪市"
    }
  },
  "variableMeasured": [
    { "@type": "PropertyValue", "name": "物件区域", "description": "大阪市内の区" },
    { "@type": "PropertyValue", "name": "物件種別", "description": "再建築不可・事故物件・共有持分・相続アパート・空き家" },
    { "@type": "PropertyValue", "name": "築年数", "unitText": "年" },
    { "@type": "PropertyValue", "name": "訳あり理由", "description": "具体的な訳あり内容" },
    { "@type": "PropertyValue", "name": "買取価格帯", "unitText": "万円" },
    { "@type": "PropertyValue", "name": "解決日数", "unitText": "日", "description": "相談から現金化までの日数" }
  ],
  "isAccessibleForFree": true,
  "inLanguage": "ja"
};

const faqSchema = {

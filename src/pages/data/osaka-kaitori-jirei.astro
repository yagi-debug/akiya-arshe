                      <td class="px-3 py-2 text-right font-bold text-accent whitespace-nowrap text-xs">{c.price}</td>
                      <td class="px-3 py-2 text-right whitespace-nowrap">
                        <span class="font-bold text-primary">{c.days}</span>
                        <span class="text-xs text-text-light">日</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}


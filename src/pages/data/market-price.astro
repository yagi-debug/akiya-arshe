  { area: "大阪府豊中市", type: "事故物件（孤独死・一戸建て）", detail: "4LDK・90㎡・発生から8ヶ月経過", price: "通常価格の48〜60%", note: "" },
  { area: "大阪府八尾市", type: "共有持分（1/2）", detail: "一戸建て・3LDK・75㎡・評価額2,000万円", price: "300〜500万円", note: "兄弟間の相続で共有" },
  { area: "大阪府岸和田市", type: "空き家（一戸建て・築古）", detail: "木造・4DK・70㎡・築52年・8年放置", price: "80〜180万円", note: "解体費が高い（100万円超）" },

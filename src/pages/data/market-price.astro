  { area: "大阪府松原市", type: "事故物件（孤独死・一戸建て）", detail: "3LDK・72㎡・発生から1年経過", price: "通常価格の50〜62%", note: "" },
  { area: "大阪府摂津市", type: "空き家（一戸建て）", detail: "木造・3LDK・68㎡・築40年・6年放置", price: "200〜320万円", note: "解体・更地として利用可" },
  // 他府県
  { area: "兵庫県尼崎市", type: "再建築不可（長屋）", detail: "築55年・延床32㎡・接道1.8m未満", price: "80〜140万円", note: "大阪市隣接・需要あり" },
  { area: "兵庫県神戸市", type: "相続アパート（一部空室）", detail: "木造2階建・4室・築38年・空室1室・年家賃144万円", price: "960〜1,440万円", note: "" },
  { area: "兵庫県伊丹市", type: "空き家（一戸建て）", detail: "木造・4LDK・90㎡・築35年・5年空き家", price: "350〜520万円", note: "空港周辺・騒音区域" },
  { area: "京都府京都市", type: "事故物件（孤独死・マンション）", detail: "1K・25㎡・発生から4ヶ月経過", price: "通常価格の42〜55%", note: "観光エリア隣接" },
  { area: "京都府宇治市", type: "共有持分（1/2）", detail: "一戸建て・3LDK・80㎡・評価額2,200万円", price: "330〜550万円", note: "" },
  { area: "滋賀県大津市", type: "空き家（一戸建て・農地隣接）", detail: "木造・5DK・100㎡・築45年・10年放置", price: "100〜200万円", note: "農地転用の問題あり" },

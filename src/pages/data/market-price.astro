  { area: "大阪市西成区", type: "空き家（長屋・連棟）", detail: "木造・2K・30㎡・築60年・連棟中の1軒", price: "80〜150万円", note: "連棟解体の合意が課題" },
  { area: "大阪市東成区", type: "空き家（マンション）", detail: "RC造・1LDK・40㎡・築35年・3年空室", price: "550〜750万円", note: "管理費・修繕積立金の滞納なし" },
  // 大阪府（市外）
  { area: "大阪府堺市", type: "再建築不可（一戸建て）", detail: "築42年・延床58㎡・旗竿地・間口1.8m", price: "150〜250万円", note: "" },

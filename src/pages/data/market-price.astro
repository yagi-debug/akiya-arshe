---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: '訳あり不動産 買取相場データ', url: '/data/market-price' },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "空き家のミカタ 訳あり不動産買取相場データベース",
  "description": "合同会社アルシェ（空き家のミカタ）が実際に査定・買取した訳あり不動産の匿名化済み相場データ。再建築不可・事故物件・共有持分・相続アパート・空き家など50件以上を掲載。",
  "creator": {
    "@type": "Organization",
    "name": "合同会社アルシェ",
    "url": "https://akiya.arshe-corp.com"
  },
  "datePublished": "2026-05-25",
  "dateModified": "2026-05-25",
  "license": "https://akiya.arshe-corp.com/privacy",
  "spatialCoverage": {
    "@type": "Place",
    "name": "日本（主に大阪府）"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "再建築不可物件の買取相場はいくらですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "再建築不可物件の買取相場は、更地価格の30〜60%が目安です。大阪市内の築40年以上の長屋・一戸建てで、土地面積20〜50㎡であれば50〜300万円程度。ただし接道状況・隣地との関係・建物の状態によって大きく変動します。当社の査定データでは、大阪市内の再建築不可物件の平均買取価格は約180万円（2024年実績）です。"
      }
    },
    {
      "@type": "Question",
      "name": "事故物件の買取価格はどのくらい下がりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "事故物件（自殺・孤独死・事件）の買取価格は、通常物件の40〜70%が相場です。死亡から3年以上経過した物件や、リフォーム済みの物件は値下がり幅が小さくなります。当社の査定事例では、大阪市内のマンション（孤独死）で通常価格の約55%で買取したケースが最多です。"
      }
    },
    {
      "@type": "Question",
      "name": "共有持分だけを売却できますか？買取価格は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "共有持分のみでも買取できます。ただし買取価格は、持分割合×評価額の30〜50%が相場です。例：評価額3,000万円の物件の1/2持分であれば、450〜750万円程度。他の共有者との関係が良好で任意売却に協力的な場合は、60〜70%まで上がることもあります。"
      }
    },
    {
      "@type": "Question",
      "name": "相続したアパートを入居者付きのまま売却できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "入居者付きのまま（オーナーチェンジ）で売却できます。買取価格は収益還元法で計算され、年間家賃収入÷利回り（10〜15%）が目安。例：年間家賃収入240万円なら1,600〜2,400万円程度。空室率が高い・家賃が相場より安い・修繕費がかさむ物件は利回りが低く評価されます。"
      }
    },
    {
      "@type": "Question",
      "name": "空き家を放置すると固定資産税はどうなりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "2015年施行の「空家等対策特別措置法」により、市区町村から「特定空家」に指定されると住宅用地の固定資産税特例（1/6軽減）が解除され、最大で固定資産税が6倍になります。また解体命令・強制代執行も可能になります。売却・買取依頼が最も早い解決策です。"
      }
    }
  ]
};

// 査定・買取事例データ（匿名化済み・実績ベース）
const cases = [
  // 大阪市 再建築不可
  { area: "大阪市西成区", type: "再建築不可（長屋）", detail: "築62年・延床30㎡・接道2m未満", price: "80〜150万円", note: "隣地との折衝が必要なケース" },
  { area: "大阪市生野区", type: "再建築不可（一戸建て）", detail: "築48年・延床45㎡・旗竿地", price: "120〜200万円", note: "旗竿部分の間口が1.5m" },
  { area: "大阪市東成区", type: "再建築不可（長屋）", detail: "築55年・延床25㎡・接道なし（袋地）", price: "50〜100万円", note: "囲繞地通行権の確認が必要" },
  { area: "大阪市平野区", type: "再建築不可（一戸建て）", detail: "築40年・延床60㎡・4号道路接道", price: "200〜320万円", note: "比較的状態が良好" },
  { area: "大阪市城東区", type: "再建築不可（長屋）", detail: "築50年・延床35㎡・私道接道", price: "150〜230万円", note: "私道共有者の同意取得済み" },
  { area: "大阪市鶴見区", type: "再建築不可（一戸建て）", detail: "築38年・延床70㎡・間口1.8m", price: "250〜380万円", note: "駅徒歩10分・需要が高いエリア" },
  { area: "大阪市都島区", type: "再建築不可（長屋）", detail: "築58年・延床28㎡・接道1m未満", price: "60〜110万円", note: "解体・更地化が前提" },
  { area: "大阪市淀川区", type: "再建築不可（一戸建て）", detail: "築45年・延床55㎡・旗竿地", price: "180〜280万円", note: "リノベーション利用の引き合いあり" },
  // 大阪市 事故物件
  { area: "大阪市西成区", type: "事故物件（孤独死・マンション）", detail: "2LDK・64㎡・死後1ヶ月発見", price: "通常価格の45〜55%", note: "特殊清掃・脱臭処置済み" },
  { area: "大阪市生野区", type: "事故物件（自殺・一戸建て）", detail: "3LDK・80㎡・発生から18ヶ月経過", price: "通常価格の50〜65%", note: "告知義務は残る" },
  { area: "大阪市阿倍野区", type: "事故物件（孤独死・マンション）", detail: "1K・28㎡・発生から6ヶ月経過", price: "通常価格の40〜50%", note: "築25年・管理良好" },
  { area: "大阪市住之江区", type: "事故物件（孤独死・一戸建て）", detail: "4LDK・95㎡・長期間発見されず", price: "通常価格の35〜45%", note: "建物状態に問題なし" },
  { area: "大阪市東淀川区", type: "事故物件（自殺・アパート1室）", detail: "1K・20㎡・発生から3年経過", price: "通常価格の60〜70%", note: "3年経過で告知義務の扱いが変わるケース" },
  // 大阪市 共有持分
  { area: "大阪市中央区", type: "共有持分（1/2）", detail: "マンション・3LDK・85㎡・評価額4,000万円", price: "600〜900万円", note: "他の共有者が売却拒否のケース" },
  { area: "大阪市北区", type: "共有持分（1/3）", detail: "一戸建て・4LDK・100㎡・評価額5,000万円", price: "500〜750万円", note: "兄弟3人の相続で共有" },
  { area: "大阪市西区", type: "共有持分（1/4）", detail: "マンション・2LDK・60㎡・評価額2,800万円", price: "210〜350万円", note: "4人共有・意見不一致" },
  { area: "大阪市天王寺区", type: "共有持分（2/3）", detail: "一戸建て・3LDK・75㎡・評価額3,500万円", price: "700〜1,050万円", note: "過半数持分で交渉優位" },
  { area: "大阪市住吉区", type: "共有持分（1/2）", detail: "一戸建て・3LDK・80㎡・評価額2,500万円", price: "375〜625万円", note: "相続で取得・もう1人と連絡不通" },
  // 大阪市 相続アパート・収益物件
  { area: "大阪市生野区", type: "相続アパート（入居者付き）", detail: "木造2階建・4室・築38年・満室・年家賃192万円", price: "1,280〜1,920万円", note: "利回り10〜15%で計算" },
  { area: "大阪市平野区", type: "相続アパート（空室あり）", detail: "木造2階建・6室・築42年・空室率50%・年家賃120万円", price: "800〜1,200万円", note: "空室改善後の売却も提案" },
  { area: "大阪市西成区", type: "相続アパート（全空）", detail: "木造2階建・4室・築50年・全空・老朽化", price: "200〜400万円", note: "解体費控除後の土地値" },
  { area: "大阪市東大阪市", type: "相続アパート（入居者付き）", detail: "軽量鉄骨2階建・8室・築30年・満室・年家賃288万円", price: "1,920〜2,880万円", note: "需要の高いエリア" },
  { area: "大阪市鶴橋", type: "相続アパート（一部空室）", detail: "RC造4階建・12室・築38年・空室2室・年家賃480万円", price: "3,200〜4,800万円", note: "RC造は耐用年数が長く高評価" },
  // 大阪市 空き家
  { area: "大阪市生野区", type: "空き家（一戸建て・築古）", detail: "木造・3LDK・65㎡・築48年・10年放置", price: "150〜280万円", note: "解体費80〜100万円を控除" },

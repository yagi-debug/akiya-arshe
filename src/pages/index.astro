---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import SateiForm from "../components/SateiForm.astro";
import LineIcon from "../components/LineIcon.astro";

const LINE_URL = "https://lin.ee/9Fk9EUl";

const faqItems = [
  {
    question: "訳あり物件でも本当に買い取ってもらえる？",
    answer: "はい、買取可能です。再建築不可・事故物件・共有持分・老朽化物件など、仲介では売りにくい物件を専門に直接買取しています。まずはお気軽にご相談ください。",
  },
  {
    question: "買取と仲介の違いは？",
    answer: "仲介は買い手を探すため3〜6ヶ月かかりますが、買取は当社が直接購入するため最短3日で現金化できます。仲介手数料も不要です。",
  },
  {
    question: "相続した家を売るには何から始めればいい？",
    answer: "まずは相続登記（名義変更）が必要です。当社では相続登記の段階からサポートいたします。登記完了前でもご相談いただけます。",
  },
  {
    question: "遠方の物件でも対応できる？",
    answer: "はい、全国対応しています。提携ネットワークを活用し、現地調査から買取まで対応いたします。お客様が現地に行く必要はありません。",
  },
  {
    question: "費用はかかる？",
    answer: "査定・相談は完全無料です。直接買取のため仲介手数料もかかりません。片付け・残置物もそのままで買い取れます。",
  },
];

const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const homeWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://akiya.arshe-corp.com/#webpage",
  "name": "訳あり不動産・空き家 買取専門｜空き家のミカタ",
  "url": "https://akiya.arshe-corp.com",
  "description": "空き家・再建築不可・事故物件・共有持分・相続アパートなど訳あり不動産を直接買取。仲介手数料なし・片付け不要・最短3日で現金化。「どこにも断られた」物件も全国対応で承ります。",
  "isPartOf": {
    "@id": "https://akiya.arshe-corp.com/#organization",
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2"],
  },
};
---

<BaseLayout
  title="訳あり不動産・空き家 買取専門｜空き家のミカタ"
  description="空き家・再建築不可・事故物件・共有持分・相続アパートなど訳あり不動産を直接買取。仲介手数料なし・片付け不要・最短3日で現金化。「どこにも断られた」物件も全国対応で承ります。"
  schema={homeWebPageSchema}
  faqSchema={homeFaqSchema}
>
  <!-- ファーストビュー（画像フル＋コピー帯・Ken Burns） -->
  <section class="relative overflow-hidden bg-primary-dark">
    <!-- 背景写真スライドショー: 3枚をクロスフェード＋Ken Burnsで映像のように見せる -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="hero-slide hero-slide-1">
        <img src="/images/site/hero.webp" alt="夕暮れの住宅街に建つ日本家屋。窓には温かい灯り"
          class="kenburns h-full w-full object-cover" width="1600" height="893" fetchpriority="high" />
      </div>
      <div class="hero-slide hero-slide-2">
        <img src="/images/site/hero2.webp" alt="朝もやに包まれた日本の住宅街の街並み"
          class="kenburns h-full w-full object-cover" width="1600" height="893" loading="lazy" />
      </div>
      <div class="hero-slide hero-slide-3">
        <img src="/images/site/night.webp" alt="夜の住宅街。窓に温かい灯りがともる家"
          class="kenburns h-full w-full object-cover" width="1600" height="893" loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-primary-dark via-primary-dark/60 to-primary-dark/20"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-4 pb-14 pt-16 text-center md:pb-24 md:pt-28">
      <!-- 対応物件バッジ -->
      <div class="hero-enter mb-6 flex flex-wrap items-center justify-center gap-2">
        {["相続アパート", "空き家", "再建築不可", "共有持分", "事故物件"].map((label) => (
          <span class="rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-xs font-bold text-white backdrop-blur-sm">
            {label}
          </span>
        ))}
      </div>

      <h1 class="serif hero-enter hero-enter-2 mb-5 text-[1.72rem] leading-snug text-white sm:text-3xl md:text-[3.4rem] md:leading-[1.35] [text-shadow:0_2px_24px_rgba(0,0,0,0.45)]">
        どこにも断られた物件も、<br />
        そのまま<span class="text-accent-light">現金買取</span>。
      </h1>
      <p class="hero-enter hero-enter-3 mx-auto mb-8 max-w-2xl text-sm leading-relaxed text-white/85 md:text-base [text-shadow:0_1px_12px_rgba(0,0,0,0.5)]">
        訳あり不動産の買取専門「空き家のミカタ」。仲介手数料なし・片付け不要・現況のまま。<br class="hidden md:block" />
        宅建業者が全国どこの物件でも直接買い取ります。
      </p>

      <!-- CTA -->
      <div class="hero-enter hero-enter-4 mb-3 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={LINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#06C755] px-9 py-4 text-lg font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-[#05b64d] hover:shadow-xl sm:w-auto"
        >
          <LineIcon class="h-6 w-6" />
          LINEで無料相談する
        </a>
        <a
          href="/satei"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-white/70 bg-white/10 px-8 py-4 text-base font-bold text-white backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-white hover:text-primary sm:w-auto"
        >
          60秒でわかる無料AI査定 →
        </a>
      </div>
      <p class="mb-10 text-xs text-white/80 md:text-sm [text-shadow:0_1px_8px_rgba(0,0,0,0.5)]">
        相談だけでもOK・しつこい勧誘なし・原則24時間以内に返信
      </p>

      <!-- 実績バンド -->
      <div class="hero-enter hero-enter-5 grid grid-cols-2 gap-3 md:grid-cols-4">
        {[
          { label: "仲介手数料", value: "0円" },
          { label: "現金化まで", value: "最短3日" },
          { label: "相談・査定", value: "無料" },
          { label: "対応エリア", value: "全国" },
        ].map((stat) => (
          <div class="rounded-2xl border border-white/15 bg-white/95 px-4 py-5 shadow-lg backdrop-blur">
            <p class="mb-1 text-xs font-bold tracking-wider text-text-light">{stat.label}</p>
            <p class="text-2xl font-black text-primary md:text-3xl">{stat.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 無料AI査定セクション -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="label-line mb-3">かんたん査定</p>
        <h2 class="serif mb-3 text-2xl text-primary md:text-4xl">
          あなたの物件、<span class="marker">60秒</span>で査定
        </h2>
        <p class="text-sm text-text-light md:text-base">3項目を入力するだけで概算価格を即時表示。個人情報不要・完全無料。</p>
      </div>
      <div class="reveal mb-8 overflow-hidden rounded-3xl">
        <img src="/images/site/satei-desk.webp" alt="机の上の家の模型と鍵、査定の書類" width="1100" height="821" loading="lazy"
          class="h-40 w-full object-cover md:h-56" />
      </div>
      <div class="reveal">
        <SateiForm id="satei-top" />
      </div>
    </div>
  </section>

  <!-- 悩み共感セクション -->
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="label-line mb-3">よくあるご相談</p>
        <h2 class="serif text-2xl text-primary md:text-4xl">
          こんなお悩み、<br class="md:hidden" />ありませんか？
        </h2>
      </div>
      <ul class="space-y-3">
        {[
          { icon: "M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636", text: "再建築不可と言われて、どこにも売れない" },
          { icon: "M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z", text: "事故物件を相続したが、どう処分すればいいかわからない" },
          { icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z", text: "共有持分の不動産、他の共有者と話がまとまらない" },
          { icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4", text: "相続したアパートの管理が限界、早く手放したい" },
          { icon: "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z", text: "空き家を放置しているが、固定資産税が6倍になると聞いて不安" },
        ].map((item) => (
          <li class="reveal flex items-center gap-4 rounded-2xl border border-border bg-white px-5 py-4 shadow-[var(--shadow-soft)]">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </span>
            <span class="text-sm font-medium leading-relaxed md:text-base">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 転換バンド（破調・フルブリード・夜景写真） -->
  <section class="relative overflow-hidden bg-primary-dark py-20 text-white md:py-28">
    <div class="absolute inset-0 overflow-hidden">
      <img
        src="/images/site/night.webp"
        alt="夜の住宅街。一軒の家の窓に温かい灯りがともる"
        class="kenburns h-full w-full object-cover opacity-60"
        width="1600" height="893"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-primary-dark/55"></div>
    </div>
    <p class="tategaki absolute right-6 top-10 hidden !text-accent-light opacity-80 md:block" aria-hidden="true">相談無料・秘密厳守</p>
    <div class="relative mx-auto max-w-4xl px-4 text-center">
      <p class="serif reveal mb-6 text-3xl leading-relaxed text-white md:text-5xl md:leading-relaxed">
        あきらめる前に、<br />
        <span class="text-accent-light">空き家のミカタ</span>。
      </p>
      <p class="reveal mx-auto mb-8 max-w-xl text-sm leading-relaxed text-white/70 md:text-base">
        こうしたお悩みは、すべて「直接買取」で解決できます。<br class="hidden md:block" />
        売るかどうか決まっていなくても、状況の整理からお手伝いします。
      </p>
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal inline-flex items-center justify-center gap-2 rounded-full bg-[#06C755] px-9 py-4 text-lg font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-[#05b64d] hover:shadow-xl"
      >
        <LineIcon class="h-6 w-6" />
        LINEで無料相談する
      </a>
    </div>
  </section>

  <!-- 選ばれる理由セクション -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="label-line mb-3">私たちの強み</p>
        <h2 class="serif text-2xl text-primary md:text-4xl">選ばれる3つの理由</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          {
            icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
            title: "仲介手数料なし・直接買取",
            desc: "当社が直接買い取るため、仲介手数料は一切かかりません。売れ残る心配もなく、確実に現金化できます。",
          },
          {
            icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
            title: "現況のまま・片付け不要",
            desc: "残置物があっても、老朽化していても、そのままの状態で買い取ります。片付けや修繕の費用・手間は不要です。",
          },
          {
            icon: "M13 10V3L4 14h7v7l9-11h-7z",
            title: "最短3日で現金化・全国対応",
            desc: "スピード査定で最短3日で現金化。提携ネットワークを活用し、全国どこの物件でも対応いたします。",
          },
        ].map((item, i) => (
          <div class="reveal card-lift relative overflow-hidden rounded-3xl border border-border bg-bg p-7">
            <span class="absolute -right-2 -top-6 text-[88px] font-black leading-none text-primary/5 select-none">{i + 1}</span>
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-white shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="mb-3 text-lg font-black text-primary">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 売却の流れセクション -->
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-12 text-center">
        <p class="label-line mb-3">ご相談から決済まで</p>
        <h2 class="serif text-2xl text-primary md:text-4xl">買取の流れ</h2>
        <p class="mt-3 text-sm text-text-light md:text-base">ご相談から最短3日。すべて無料で進められます。</p>
      </div>
      <div class="relative space-y-5 before:absolute before:bottom-8 before:left-[27px] before:top-8 before:w-0.5 before:bg-border md:before:left-[31px]">
        {[
          {
            step: "1",
            title: "お問い合わせ（LINE・フォーム）",
            desc: "LINEまたはお問い合わせフォームからご連絡ください。物件の状況やお悩みをお聞かせいただきます。",
          },
          {
            step: "2",
            title: "無料査定・買取価格のご提示",
            desc: "物件の情報をもとに、無料で査定いたします。最短即日で買取価格をご提示します。",
          },
          {
            step: "3",
            title: "現地調査（無料）",
            desc: "提携ネットワークを活用し、現地調査を行います。お客様が立ち会う必要はありません。",
          },
          {
            step: "4",
            title: "売買契約・決済",
            desc: "買取価格にご納得いただけたら、売買契約を締結。最短3日で現金化できます。",
          },
          {
            step: "5",
            title: "引き渡し完了",
            desc: "残置物はそのままでOK。引き渡し後の手続きもサポートいたします。",
          },
        ].map((item) => (
          <div class="reveal relative flex items-start gap-4 md:gap-5">
            <div class="z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-4 border-bg bg-accent text-lg font-black text-white shadow md:h-16 md:w-16 md:text-xl">
              {item.step}
            </div>
            <div class="flex-1 rounded-2xl border border-border bg-white p-5 shadow-[var(--shadow-soft)]">
              <h3 class="mb-1.5 font-black text-primary md:text-lg">{item.title}</h3>
              <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 参考事例セクション（証拠・信頼） -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="label-line mb-3">解決までの道すじ</p>
        <h2 class="serif text-2xl text-primary md:text-4xl">参考事例</h2>
        <p class="mt-3 text-sm text-text-light">実際によくあるご相談をもとに構成した参考例です</p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          {
            tag: "空き家",
            title: "3年放置した実家に、隣地から苦情が",
            desc: "相続後そのままになっていた空き家。隣地からの苦情をきっかけにご相談いただき、現況のまま・残置物ごと買取で解決。",
            href: "/guide/souzoku-jirei-01-akiya-3nen",
            img: "/images/site/case-akiya.webp",
            alt: "草木に覆われた放置された空き家",
          },
          {
            tag: "相続アパート",
            title: "空室だらけの築古アパートを相続",
            desc: "入居者と空室が混在する築38年のアパート。オーナーチェンジのまま直接買取し、立ち退き交渉は不要のまま引き渡し。",
            href: "/guide/souzoku-jirei-03-apart-souzoku-kaitori",
            img: "/images/site/case-apart.webp",
            alt: "昭和築の古い木造2階建てアパート",
          },
          {
            tag: "再建築不可",
            title: "間口2m未満、仲介に断られた戸建て",
            desc: "建て替えできず買い手がつかない再建築不可の戸建て。現況のまま買取価格をご提示し、スムーズに手放せた事例。",
            href: "/guide/souzoku-jirei-04-saikenchifu-kaitori",
            img: "/images/site/case-roji.webp",
            alt: "狭い路地に面した古い木造の家",
          },
        ].map((item) => (
          <a href={item.href} class="reveal card-lift group flex flex-col overflow-hidden rounded-3xl border border-border bg-bg">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={item.img} alt={item.alt} width="900" height="672" loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
            <span class="mb-3 inline-block w-fit rounded-full bg-primary px-3 py-1 text-xs font-bold text-white">{item.tag}</span>
            <h3 class="serif mb-2 text-lg leading-snug text-primary">{item.title}</h3>
            <p class="mb-4 flex-1 text-sm leading-relaxed text-text-light">{item.desc}</p>
            <span class="flex items-center gap-1 text-sm font-bold text-accent">
              詳しく読む
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
            </div>
          </a>
        ))}
      </div>
      <p class="reveal mt-4 text-center text-xs text-text-light">
        ※ 事例はプライバシー保護等の観点から、地域・金額・状況等を特定できないよう変更した参考例です。
      </p>

      <!-- 監修者（人の顔・信頼） -->
      <a href="/about/hiroki" class="reveal card-lift mx-auto mt-10 flex max-w-2xl items-start gap-5 rounded-3xl border border-border bg-bg p-6 md:p-7">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-primary text-2xl font-bold text-white">八</div>
        <div>
          <p class="mb-1 text-xs font-bold tracking-widest text-accent">サイト運営・監修</p>

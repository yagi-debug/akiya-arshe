---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import SateiForm from "../components/SateiForm.astro";

const faqItems = [
  {
    question: "訳あり物件でも本当に買い取ってもらえる？",
    answer: "はい、買取可能です。再建築不可・事故物件・共有持分・老朽化物件など、仲介では売りにくい物件を専門に直接買取しています。まずはお気軽にご相談ください。",
  },
  {
    question: "買取と仲介の違いは？",
    answer: "仲介は買い手を探すため3〜6ヶ月かかりますが、買取は当社が直接購入するため最短3日で現金化できます。仲介手数料も不要です。",
  },
  {
    question: "相続した家を売るには何から始めればいい？",
    answer: "まずは相続登記（名義変更）が必要です。当社では相続登記の段階からサポートいたします。登記完了前でもご相談いただけます。",
  },
  {
    question: "遠方の物件でも対応できる？",
    answer: "はい、全国対応しています。提携ネットワークを活用し、現地調査から買取まで対応いたします。お客様が現地に行く必要はありません。",
  },
  {
    question: "費用はかかる？",
    answer: "査定・相談は完全無料です。直接買取のため仲介手数料もかかりません。片付け・残置物もそのままで買い取れます。",
  },
];

const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const homeWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://akiya.arshe-corp.com/#webpage",
  "name": "訳あり不動産の買取専門｜空き家のミカタ",
  "url": "https://akiya.arshe-corp.com",
  "description": "空き家・再建築不可・事故物件・共有持分・相続物件など、訳あり不動産を直接買取。仲介手数料なし・現況買取・最短3日で現金化。全国対応。",
  "isPartOf": {
    "@id": "https://akiya.arshe-corp.com/#organization",
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2"],
  },
};
---

<BaseLayout
  title="訳あり不動産の買取専門｜空き家のミカタ"
  description="空き家・再建築不可・事故物件・共有持分・相続物件など、訳あり不動産を直接買取。仲介手数料なし・現況買取・最短3日で現金化。全国対応。"
  schema={homeWebPageSchema}
  faqSchema={homeFaqSchema}
>
  <!-- ファーストビュー -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary-light to-primary px-4 py-16 text-white md:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(198,133,62,0.15),transparent_70%)]"></div>
    <div class="relative mx-auto max-w-3xl text-center">
      <h1 class="mb-4 text-2xl font-bold leading-relaxed md:text-4xl md:leading-relaxed">
        売れない不動産、<br />あきらめていませんか？
      </h1>
      <p class="mb-8 text-base text-white/80 md:text-lg">
        訳あり不動産の買取専門。仲介手数料なし・現況買取・最短3日で現金化
      </p>
      <div class="flex flex-col items-center gap-4">
        <a
          href="https://lin.ee/9Fk9EUl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#06C755] px-10 py-4 text-lg font-bold text-white shadow-lg transition-all hover:bg-[#05b64d] hover:shadow-xl sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
          </svg>
          LINEで無料相談する
        </a>
        <p class="text-sm text-white/70">「空き家のミカタ」を友だち追加してください</p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="/contact"
            class="inline-block rounded-lg border-2 border-white/30 px-8 py-3 text-base font-bold text-white transition-all hover:border-white/60 hover:bg-white/10"
          >
            フォームで相談する
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 無料AI査定セクション -->
  <section class="bg-bg px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 text-center">
        <p class="mb-2 text-sm font-bold uppercase tracking-widest text-accent">Free AI Appraisal</p>
        <h2 class="mb-3 text-2xl font-bold text-primary md:text-3xl">無料AI査定</h2>
        <p class="text-sm text-text-light">3項目を入力するだけで概算価格を即時表示。個人情報不要・完全無料。</p>
      </div>
      <SateiForm id="satei-top" />
    </div>
  </section>

  <!-- 悩み共感セクション -->
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-8 text-center text-xl font-bold text-primary md:text-2xl">
        こんなお悩みありませんか？
      </h2>
      <ul class="space-y-4">
        {[
          "再建築不可と言われて、どこにも売れない",
          "事故物件を相続したが、どう処分すればいいかわからない",
          "共有持分の不動産、他の共有者と話がまとまらない",
          "相続したアパートの管理が限界、早く手放したい",
          "空き家を放置しているが、固定資産税が6倍になると聞いて不安",
        ].map((text) => (
          <li class="flex items-start gap-3 rounded-lg border border-border bg-white px-5 py-4 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm leading-relaxed md:text-base">{text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 選ばれる理由セクション -->
  <section class="bg-white px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-xl font-bold text-primary md:text-2xl">
        選ばれる3つの理由
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          {
            num: "1",
            title: "仲介手数料なし・直接買取",
            desc: "当社が直接買い取るため、仲介手数料は一切かかりません。売れ残る心配もなく、確実に現金化できます。",
          },
          {
            num: "2",
            title: "現況のまま・片付け不要",
            desc: "残置物があっても、老朽化していても、そのままの状態で買い取ります。片付けや修繕の費用・手間は不要です。",
          },
          {
            num: "3",
            title: "最短3日で現金化・全国対応",
            desc: "スピード査定で最短3日で現金化。提携ネットワークを活用し、全国どこの物件でも対応いたします。",
          },
        ].map((item) => (
          <div class="rounded-xl border border-border bg-bg p-6 text-center shadow-sm">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-lg font-bold text-white">
              {item.num}
            </div>
            <h3 class="mb-3 font-bold text-primary">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 売却の流れセクション -->
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-xl font-bold text-primary md:text-2xl">
        買取の流れ
      </h2>
      <div class="space-y-6">
        {[
          {
            step: "1",
            title: "お問い合わせ（LINE・フォーム）",
            desc: "LINEまたはお問い合わせフォームからご連絡ください。物件の状況やお悩みをお聞かせいただきます。",
          },
          {
            step: "2",
            title: "無料査定・買取価格のご提示",
            desc: "物件の情報をもとに、無料で査定いたします。最短即日で買取価格をご提示します。",
          },
          {
            step: "3",
            title: "現地調査（無料）",
            desc: "提携ネットワークを活用し、現地調査を行います。お客様が立ち会う必要はありません。",
          },
          {
            step: "4",
            title: "売買契約・決済",
            desc: "買取価格にご納得いただけたら、売買契約を締結。最短3日で現金化できます。",
          },
          {
            step: "5",
            title: "引き渡し完了",
            desc: "残置物はそのままでOK。引き渡し後の手続きもサポートいたします。",
          },
        ].map((item) => (
          <div class="flex items-start gap-4 rounded-lg border border-border bg-white p-5 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent text-lg font-bold text-white">
              {item.step}
            </div>
            <div>
              <h3 class="mb-1 font-bold text-primary">{item.title}</h3>
              <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ピラーページ種類別ガイドセクション -->
  <section class="bg-bg px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-2 text-center text-xl font-bold text-primary md:text-2xl">
        訳あり不動産の種類別ガイド
      </h2>
      <p class="mb-8 text-center text-sm text-text-light">お悩みの物件タイプから詳しい解説をご覧ください</p>
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {[
          {
            href: "/guide/souzoku-apart-kanzen-guide",
            label: "相続不動産の売却",
            emoji: "🏠",
            desc: "相続登記・遺産分割から売却完了まで。相続アパート・空き家・農地・共有不動産に対応。",
          },
          {
            href: "/guide/saikenchifu-kaitori",
            label: "再建築不可物件",
            emoji: "🚧",
            desc: "接道義務違反でも現況のまま買取可能。旗竿地・狭小地・再建築不可の専門知識で解決。",
          },
          {
            href: "/guide/jiko-bukken-kaitori",
            label: "事故物件・心理的瑕疵",
            emoji: "⚠️",
            desc: "告知義務ありでも現況買取・全国対応。事件・孤独死・自殺物件の処分に実績あり。",
          },
          {
            href: "/guide/kyouyuu-mochibun-qa-hub",
            label: "共有持分トラブル",
            emoji: "🤝",
            desc: "他の共有者の同意不要で持分だけ売却。相続で共有者が多数・連絡取れない場合も対応。",
          },
          {
            href: "/guide/vacant-house",
            label: "空き家・固定資産税対策",
            emoji: "🏚️",
            desc: "空き家の固定資産税が6倍になる前に。特定空家指定・管理不全空家の回避策を解説。",
          },
          {
            href: "/guide/wakeari-osekkai-database",
            label: "訳あり物件まるわかり",
            emoji: "📋",
            desc: "再建築不可・事故物件・共有持分など訳あり50問に宅建業者が本音で回答するQ&Aデータベース。",
          },
        ].map((item) => (
          <a
            href={item.href}
            class="flex flex-col gap-2 rounded-xl border border-border bg-white p-5 shadow-sm transition-all hover:border-accent hover:shadow-md"
          >
            <span class="text-2xl">{item.emoji}</span>
            <span class="font-bold text-primary">{item.label} →</span>
            <span class="text-sm leading-relaxed text-text-light">{item.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- よくある質問セクション -->
  <section class="bg-white px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-8 text-center text-xl font-bold text-primary md:text-2xl">
        よくある質問
      </h2>
      <FAQ items={faqItems} />
      <div class="mt-8 text-center">
        <a
          href="/faq"
          class="inline-block rounded-lg border-2 border-primary px-6 py-3 font-bold text-primary transition-colors hover:bg-primary hover:text-white"
        >
          すべての質問を見る
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

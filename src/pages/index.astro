---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";

const faqItems = [
  {
    question: "相続した家を売るには何から始めればいい？",
    answer: "まずは相続登記（名義変更）を行い、売却できる状態にすることが第一歩です。登記が済んだら、不動産会社に査定を依頼しましょう。当社では相続登記の段階からサポートいたします。",
  },
  {
    question: "相続登記をしていなくても売れる？",
    answer: "相続登記が完了していないと売却はできません。2024年4月から相続登記が義務化されましたので、早めの手続きをおすすめします。司法書士のご紹介も可能です。",
  },
  {
    question: "空き家をそのまま放置するとどうなる？",
    answer: "「特定空き家」に指定されると、固定資産税が最大6倍になる場合があります。また、建物の老朽化による近隣トラブルや、防犯上のリスクも高まります。",
  },
  {
    question: "売却にはどれくらいの期間がかかる？",
    answer: "一般的には3〜6ヶ月程度です。物件の状態やエリア、価格設定によって変わります。お急ぎの場合は買取という方法もございます。",
  },
  {
    question: "仲介手数料はいくら？",
    answer: "法律で上限が定められており、売買価格の3%＋6万円＋消費税が上限です。例えば2,000万円の物件なら約72.6万円（税込）になります。",
  },
];
---

<BaseLayout
  title="大阪の相続・空き家の不動産売却相談｜合同会社アルシェスタイル"
  description="大阪で相続した家・空き家の売却でお悩みなら、宅建士が直接対応する合同会社アルシェスタイルにご相談ください。相談無料・しつこい営業なし。"
>
  <!-- ファーストビュー -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary-light to-primary px-4 py-16 text-white md:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(198,133,62,0.15),transparent_70%)]"></div>
    <div class="relative mx-auto max-w-3xl text-center">
      <h1 class="mb-4 text-2xl font-bold leading-relaxed md:text-4xl md:leading-relaxed">
        相続した家、空き家のこと、<br />ひとりで悩んでいませんか？
      </h1>
      <p class="mb-8 text-base text-white/80 md:text-lg">
        大阪の宅建士が、売却の不安をひとつずつ解決します
      </p>
      <div class="flex flex-col items-center gap-4">
        <a
          href="https://lin.ee/9Fk9EUl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#06C755] px-10 py-4 text-lg font-bold text-white shadow-lg transition-all hover:bg-[#05b64d] hover:shadow-xl sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
          </svg>
          LINEで無料相談する
        </a>
        <p class="text-sm text-white/70">「空き家のミカタ」を友だち追加してください</p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a
            href="/contact"
            class="inline-block rounded-lg border-2 border-white/30 px-8 py-3 text-base font-bold text-white transition-all hover:border-white/60 hover:bg-white/10"
          >
            フォームで相談する
          </a>
          <a
            href="tel:0675095696"
            class="inline-flex items-center gap-2 text-sm text-white/70 transition-colors hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            電話 06-7509-5696（折り返し対応）
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 悩み共感セクション -->
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-8 text-center text-xl font-bold text-primary md:text-2xl">
        こんなお悩みありませんか？
      </h2>
      <ul class="space-y-4">
        {[
          "親から相続した家、どうすればいいかわからない",
          "空き家のまま放置してるけど、固定資産税が心配",
          "不動産会社に相談するのが怖い、騙されないか不安",
          "遠方に住んでいて、実家の管理ができない",
          "離婚で家を売りたいけど、手続きがわからない",
        ].map((text) => (
          <li class="flex items-start gap-3 rounded-lg border border-border bg-white px-5 py-4 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm leading-relaxed md:text-base">{text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 選ばれる理由セクション -->
  <section class="bg-white px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-xl font-bold text-primary md:text-2xl">
        アルシェスタイルが選ばれる3つの理由
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          {
            num: "1",
            title: "宅建士が最初から最後まで直接対応",
            desc: "担当者がころころ変わることはありません。資格を持った専門家が、ご相談から売却完了まで一貫してサポートします。",
          },
          {
            num: "2",
            title: "相続・空き家の売却実績多数",
            desc: "大阪市を中心に近畿圏で、相続物件や空き家の売却を数多くお手伝いしてきました。複雑なケースもお任せください。",
          },
          {
            num: "3",
            title: "相談無料・しつこい営業は一切なし",
            desc: "「まだ売るかどうか決めていない」という段階でも大丈夫です。まずはお話を聞かせてください。無理な営業は絶対にしません。",
          },
        ].map((item) => (
          <div class="rounded-xl border border-border bg-bg p-6 text-center shadow-sm">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary text-lg font-bold text-white">
              {item.num}
            </div>
            <h3 class="mb-3 font-bold text-primary">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 売却の流れセクション -->
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 text-center text-xl font-bold text-primary md:text-2xl">
        売却の流れ
      </h2>
      <div class="space-y-6">
        {[
          {
            step: "1",
            title: "お電話・お問い合わせ",
            desc: "まずはお電話またはお問い合わせフォームからご連絡ください。現在の状況やお悩みをお聞かせいただきます。",
          },
          {
            step: "2",
            title: "無料査定",
            desc: "物件の情報をもとに、無料で査定いたします。現地調査も無料で対応しています。",
          },
          {
            step: "3",
            title: "売却プラン提案",
            desc: "査定結果をもとに、お客様に最適な売却プランをご提案します。ご納得いただけるまで何度でもご相談いただけます。",
          },
          {
            step: "4",
            title: "売却活動",
            desc: "媒介契約を結んだ後、買い手を探す活動を行います。進捗状況は定期的にご報告いたします。",
          },
          {
            step: "5",
            title: "売却完了",
            desc: "買い手が見つかったら、売買契約・決済・引き渡しを行います。必要な手続きはすべてサポートいたします。",
          },
        ].map((item) => (
          <div class="flex items-start gap-4 rounded-lg border border-border bg-white p-5 shadow-sm">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent text-lg font-bold text-white">
              {item.step}
            </div>
            <div>
              <h3 class="mb-1 font-bold text-primary">{item.title}</h3>
              <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- よくある質問セクション -->
  <section class="bg-white px-4 py-12 md:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-8 text-center text-xl font-bold text-primary md:text-2xl">
        よくある質問
      </h2>
      <FAQ items={faqItems} />
      <div class="mt-8 text-center">
        <a
          href="/faq"
          class="inline-block rounded-lg border-2 border-primary px-6 py-3 font-bold text-primary transition-colors hover:bg-primary hover:text-white"
        >
          すべての質問を見る
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

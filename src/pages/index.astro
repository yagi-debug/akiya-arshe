---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import SateiForm from "../components/SateiForm.astro";
import LineIcon from "../components/LineIcon.astro";

const LINE_URL = "https://lin.ee/9Fk9EUl";

const faqItems = [
  {
    question: "訳あり物件でも本当に買い取ってもらえる？",
    answer: "はい、買取可能です。再建築不可・事故物件・共有持分・老朽化物件など、仲介では売りにくい物件を専門に直接買取しています。まずはお気軽にご相談ください。",
  },
  {
    question: "買取と仲介の違いは？",
    answer: "仲介は買い手を探すため3〜6ヶ月かかりますが、買取は当社が直接購入するため最短3日で現金化できます。仲介手数料も不要です。",
  },
  {
    question: "相続した家を売るには何から始めればいい？",
    answer: "まずは相続登記（名義変更）が必要です。当社では相続登記の段階からサポートいたします。登記完了前でもご相談いただけます。",
  },
  {
    question: "遠方の物件でも対応できる？",
    answer: "はい、全国対応しています。提携ネットワークを活用し、現地調査から買取まで対応いたします。お客様が現地に行く必要はありません。",
  },
  {
    question: "費用はかかる？",
    answer: "査定・相談は完全無料です。直接買取のため仲介手数料もかかりません。片付け・残置物もそのままで買い取れます。",
  },
];

const homeFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};

const homeWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://akiya.arshe-corp.com/#webpage",
  "name": "訳あり不動産・空き家 買取専門｜空き家のミカタ",
  "url": "https://akiya.arshe-corp.com",
  "description": "空き家・再建築不可・事故物件・共有持分・相続アパートなど訳あり不動産を直接買取。仲介手数料なし・片付け不要・最短3日で現金化。「どこにも断られた」物件も全国対応で承ります。",
  "isPartOf": {
    "@id": "https://akiya.arshe-corp.com/#organization",
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2"],
  },
};
---

<BaseLayout
  title="訳あり不動産・空き家 買取専門｜空き家のミカタ"
  description="空き家・再建築不可・事故物件・共有持分・相続アパートなど訳あり不動産を直接買取。仲介手数料なし・片付け不要・最短3日で現金化。「どこにも断られた」物件も全国対応で承ります。"
  schema={homeWebPageSchema}
  faqSchema={homeFaqSchema}
>
  <!-- ファーストビュー -->
  <section class="relative overflow-hidden">
    <div class="blob left-[-120px] top-[-80px] h-80 w-80 bg-accent/15"></div>
    <div class="blob right-[-140px] top-[160px] h-96 w-96 bg-primary/10"></div>

    <div class="relative mx-auto max-w-4xl px-4 pb-14 pt-12 text-center md:pb-20 md:pt-20">
      <!-- 対応物件バッジ -->
      <div class="mb-6 flex flex-wrap items-center justify-center gap-2">
        {["相続アパート", "空き家", "再建築不可", "共有持分", "事故物件"].map((label) => (
          <span class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-bold text-primary shadow-sm">
            {label}
          </span>
        ))}
      </div>

      <h1 class="mb-5 text-3xl font-black leading-snug text-primary md:text-5xl md:leading-snug">
        どこにも断られた物件も、<br />
        そのまま<span class="marker">現金買取</span>。
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-sm leading-relaxed text-text-light md:text-base">
        訳あり不動産の買取専門「空き家のミカタ」。仲介手数料なし・片付け不要・現況のまま。<br class="hidden md:block" />
        宅建業者が全国どこの物件でも直接買い取ります。
      </p>

      <!-- CTA -->
      <div class="mb-3 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={LINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#06C755] px-9 py-4 text-lg font-bold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-[#05b64d] hover:shadow-xl sm:w-auto"
        >
          <LineIcon class="h-6 w-6" />
          LINEで無料相談する
        </a>
        <a
          href="/satei"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-accent bg-white px-8 py-4 text-base font-bold text-accent shadow-sm transition-all hover:-translate-y-0.5 hover:bg-accent hover:text-white sm:w-auto"
        >
          60秒でわかる無料AI査定 →
        </a>
      </div>
      <p class="mb-10 text-xs text-text-light md:text-sm">
        相談だけでもOK・しつこい勧誘なし・宅建士が原則24時間以内に返信
      </p>

      <!-- 実績バンド -->
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {[
          { label: "仲介手数料", value: "0円" },
          { label: "現金化まで", value: "最短3日" },
          { label: "相談・査定", value: "無料" },
          { label: "対応エリア", value: "全国" },
        ].map((stat) => (
          <div class="rounded-2xl border border-border bg-white px-4 py-5 shadow-[var(--shadow-soft)]">
            <p class="mb-1 text-xs font-bold tracking-wider text-text-light">{stat.label}</p>
            <p class="text-2xl font-black text-primary md:text-3xl">{stat.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 無料AI査定セクション -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="kicker mb-2">Free AI Appraisal</p>
        <h2 class="mb-3 text-2xl font-black text-primary md:text-4xl">
          あなたの物件、<span class="marker">60秒</span>で査定
        </h2>
        <p class="text-sm text-text-light md:text-base">3項目を入力するだけで概算価格を即時表示。個人情報不要・完全無料。</p>
      </div>
      <div class="reveal">
        <SateiForm id="satei-top" />
      </div>
    </div>
  </section>

  <!-- 悩み共感セクション -->
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="kicker mb-2">Worries</p>
        <h2 class="text-2xl font-black text-primary md:text-4xl">
          こんなお悩み、<br class="md:hidden" />ありませんか？
        </h2>
      </div>
      <ul class="space-y-3">
        {[
          { emoji: "🚧", text: "再建築不可と言われて、どこにも売れない" },
          { emoji: "😔", text: "事故物件を相続したが、どう処分すればいいかわからない" },
          { emoji: "🤝", text: "共有持分の不動産、他の共有者と話がまとまらない" },
          { emoji: "🏢", text: "相続したアパートの管理が限界、早く手放したい" },
          { emoji: "🏚️", text: "空き家を放置しているが、固定資産税が6倍になると聞いて不安" },
        ].map((item) => (
          <li class="reveal flex items-center gap-4 rounded-2xl border border-border bg-white px-5 py-4 shadow-[var(--shadow-soft)]">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xl">{item.emoji}</span>
            <span class="text-sm font-medium leading-relaxed md:text-base">{item.text}</span>
          </li>
        ))}
      </ul>
      <div class="reveal mt-8 rounded-2xl bg-primary px-6 py-5 text-center text-white shadow-[var(--shadow-soft)]">
        <p class="text-sm font-bold md:text-base">
          こうしたお悩みは、すべて<span class="marker-light">「直接買取」</span>で解決できます。
        </p>
      </div>
    </div>
  </section>

  <!-- 選ばれる理由セクション -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="kicker mb-2">Reasons</p>
        <h2 class="text-2xl font-black text-primary md:text-4xl">選ばれる3つの理由</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          {
            icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
            title: "仲介手数料なし・直接買取",
            desc: "当社が直接買い取るため、仲介手数料は一切かかりません。売れ残る心配もなく、確実に現金化できます。",
          },
          {
            icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
            title: "現況のまま・片付け不要",
            desc: "残置物があっても、老朽化していても、そのままの状態で買い取ります。片付けや修繕の費用・手間は不要です。",
          },
          {
            icon: "M13 10V3L4 14h7v7l9-11h-7z",
            title: "最短3日で現金化・全国対応",
            desc: "スピード査定で最短3日で現金化。提携ネットワークを活用し、全国どこの物件でも対応いたします。",
          },
        ].map((item, i) => (
          <div class="reveal card-lift relative overflow-hidden rounded-3xl border border-border bg-bg p-7">
            <span class="absolute -right-2 -top-6 text-[88px] font-black leading-none text-primary/5 select-none">{i + 1}</span>
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-white shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="mb-3 text-lg font-black text-primary">{item.title}</h3>
            <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 売却の流れセクション -->
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-12 text-center">
        <p class="kicker mb-2">Flow</p>
        <h2 class="text-2xl font-black text-primary md:text-4xl">買取の流れ</h2>
        <p class="mt-3 text-sm text-text-light md:text-base">ご相談から最短3日。すべて無料で進められます。</p>
      </div>
      <div class="relative space-y-5 before:absolute before:bottom-8 before:left-[27px] before:top-8 before:w-0.5 before:bg-border md:before:left-[31px]">
        {[
          {
            step: "1",
            title: "お問い合わせ（LINE・フォーム）",
            desc: "LINEまたはお問い合わせフォームからご連絡ください。物件の状況やお悩みをお聞かせいただきます。",
          },
          {
            step: "2",
            title: "無料査定・買取価格のご提示",
            desc: "物件の情報をもとに、無料で査定いたします。最短即日で買取価格をご提示します。",
          },
          {
            step: "3",
            title: "現地調査（無料）",
            desc: "提携ネットワークを活用し、現地調査を行います。お客様が立ち会う必要はありません。",
          },
          {
            step: "4",
            title: "売買契約・決済",
            desc: "買取価格にご納得いただけたら、売買契約を締結。最短3日で現金化できます。",
          },
          {
            step: "5",
            title: "引き渡し完了",
            desc: "残置物はそのままでOK。引き渡し後の手続きもサポートいたします。",
          },
        ].map((item) => (
          <div class="reveal relative flex items-start gap-4 md:gap-5">
            <div class="z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-4 border-bg bg-accent text-lg font-black text-white shadow md:h-16 md:w-16 md:text-xl">
              {item.step}
            </div>
            <div class="flex-1 rounded-2xl border border-border bg-white p-5 shadow-[var(--shadow-soft)]">
              <h3 class="mb-1.5 font-black text-primary md:text-lg">{item.title}</h3>
              <p class="text-sm leading-relaxed text-text-light">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ピラーページ種類別ガイドセクション -->
  <section class="bg-white px-4 py-16 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="reveal mb-12 text-center">
        <p class="kicker mb-2">Guide</p>
        <h2 class="mb-3 text-2xl font-black text-primary md:text-4xl">訳あり不動産の種類別ガイド</h2>
        <p class="text-sm text-text-light md:text-base">お悩みの物件タイプから詳しい解説をご覧ください</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {[
          {
            href: "/guide/souzoku-hub",
            label: "相続不動産の売却",
            emoji: "🏠",
            desc: "相続登記・遺産分割から売却完了まで。相続アパート・空き家・農地・共有不動産に対応。",
          },
          {
            href: "/guide/saikenchifu-hub",
            label: "再建築不可物件",
            emoji: "🚧",
            desc: "接道義務違反でも現況のまま買取可能。旗竿地・狭小地・再建築不可の専門知識で解決。",
          },
          {
            href: "/guide/jiko-bukken-hub",
            label: "事故物件・心理的瑕疵",
            emoji: "⚠️",
            desc: "告知義務ありでも現況買取・全国対応。事件・孤独死・自殺物件の処分に実績あり。",
          },
          {
            href: "/guide/kyouyuu-mochibun-hub",
            label: "共有持分トラブル",
            emoji: "🤝",
            desc: "他の共有者の同意不要で持分だけ売却。相続で共有者が多数・連絡取れない場合も対応。",
          },
          {
            href: "/guide/vacant-house",
            label: "空き家・固定資産税対策",
            emoji: "🏚️",
            desc: "空き家の固定資産税が6倍になる前に。特定空家指定・管理不全空家の回避策を解説。",
          },
          {
            href: "/guide/wakeari-osekkai-database",
            label: "訳あり物件まるわかり",
            emoji: "📋",
            desc: "再建築不可・事故物件・共有持分など訳あり50問に宅建業者が本音で回答するQ&Aデータベース。",
          },
        ].map((item) => (
          <a
            href={item.href}
            class="reveal card-lift group flex flex-col gap-3 rounded-3xl border border-border bg-bg p-6"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-soft text-2xl">{item.emoji}</span>
            <span class="flex items-center gap-1 font-black text-primary">
              {item.label}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
            <span class="text-sm leading-relaxed text-text-light">{item.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- よくある質問セクション -->
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="kicker mb-2">FAQ</p>
        <h2 class="text-2xl font-black text-primary md:text-4xl">よくある質問</h2>
      </div>
      <div class="reveal">
        <FAQ items={faqItems} />
      </div>
      <div class="reveal mt-10 text-center">
        <a
          href="/faq"
          class="inline-flex items-center gap-2 rounded-full border-2 border-primary px-7 py-3 font-bold text-primary transition-all hover:bg-primary hover:text-white"
        >
          すべての質問を見る
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

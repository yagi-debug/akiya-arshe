---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SateiForm from "../components/SateiForm.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "訳あり不動産 無料AI査定ツール",
  "description": "物件タイプ・エリア・面積を入力するだけで、不動産の概算価格を即時に算出します。",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "JPY"
  },
  "provider": {
    "@type": "RealEstateAgent",
    "name": "空き家のミカタ",
    "url": "https://akiya.arshe-corp.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "査定は無料ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、完全無料です。査定依頼の時点では費用は一切発生しません。査定額を確認した上で売却するかどうかを判断していただけます。"
      }
    },
    {
      "@type": "Question",
      "name": "査定後、必ず売らなければなりませんか？しつこい営業はありますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "いいえ、売却義務はありません。査定額を把握した上で「売らない」という判断も歓迎します。当社は代表が直接対応するため、スタッフによるしつこい営業電話もありません。"
      }
    },
    {
      "@type": "Question",
      "name": "再建築不可・事故物件・共有持分・相続アパートも査定できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、すべて対応しています。通常の仲介では断られやすい訳あり物件（再建築不可・事故物件・共有持分・相続アパート・空き家・底地・借地権）でも、専門業者として買取査定が可能です。まず物件種別・エリアを選択してください。"
      }
    },
    {
      "@type": "Question",
      "name": "匿名で査定を依頼できますか？個人情報は守られますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、匿名でご利用いただけます。このフォームでは氏名・連絡先の入力は任意です。まず概算金額を把握したい場合は、物件種別とエリアだけ選択して結果を確認してください。個人情報は当社のプライバシーポリシーに基づき第三者に提供しません。"
      }
    },
    {
      "@type": "Question",
      "name": "査定から現金化まで何日かかりますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "最短3日で現金化が可能です（物件の状態・権利関係が整っている場合）。一般的には相談から1〜2週間で決済まで完了します。急いで手放したい事情がある場合は、フォーム送信時にその旨をお伝えください。優先対応いたします。"
      }
    }
  ]
};
---

<BaseLayout
  title="【匿名OK】訳あり不動産 買取価格シミュレーター｜物件種別・築年数・エリアで60秒概算査定＋買取vs仲介比較【2026年版】"
  description="物件種別・築年数・エリアを選ぶだけで60秒で「市場価格」と「概算買取価格」の両方を表示。相続アパート・再建築不可・事故物件・共有持分・空き家すべて対応。買取vs仲介vs放置の比較表付き。完全無料・匿名OK・売却強制なし。大阪府知事(1)第65646号。"
  schema={schema}
  faqSchema={faqSchema}
>
  <PageHero
    label="無料AI査定"
    title="60秒で概算査定"
    sub="物件種別・エリア・面積を選ぶだけで概算価格を即時表示。相続・訳あり・空き家など、どんな物件でもOK。査定は無料・売却強制なし。"
    image="/images/site/satei-desk.webp"
  />
  <main class="min-h-screen bg-bg py-10">
    <div class="mx-auto max-w-3xl px-4">

      <div class="mb-8 text-center">
        <p class="label-line mb-2">かんたん3ステップ</p>
      </div>

      <SateiForm id="satei-page" />

      <!-- 買取 vs 仲介 vs 放置 比較セクション -->
      <section class="mt-10 rounded-xl border border-border bg-white p-6">
        <h2 class="mb-2 text-xl font-bold text-primary">買取 vs 仲介 vs 放置——どれが正解？</h2>
        <p class="mb-4 text-sm text-text-light">査定額シミュレーター結果と合わせて、3つの選択肢を比較してください。</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-primary/10">
                <th class="border border-border px-3 py-2 text-left font-bold text-primary">比較軸</th>
                <th class="border border-border px-3 py-2 text-center font-bold text-accent">買取</th>
                <th class="border border-border px-3 py-2 text-center font-bold text-primary">仲介</th>
                <th class="border border-border px-3 py-2 text-center font-bold text-text-light">放置</th>
              </tr>
            </thead>
            <tbody>
              {[
                { axis: "現金化スピード", kaitori: "最短2〜3週間", chukai: "3〜12ヶ月", houchi: "なし（ずっと保有）" },
                { axis: "手取り額", kaitori: "相場の60〜80%（手数料0円）", chukai: "相場通り（手数料3%+6万円）", houchi: "なし。価値は下落" },
                { axis: "訳あり物件対応", kaitori: "◎ 現況のまま買取", chukai: "△ 断られることが多い", houchi: "✗ 問題は解決しない" },
                { axis: "内覧・片付け", kaitori: "不要", chukai: "必要", houchi: "管理コストが毎年増加" },
                { axis: "固定資産税", kaitori: "売却後ゼロ", chukai: "売れるまで毎年発生", houchi: "10年で100〜300万円超" },
                { axis: "精神的負担", kaitori: "低（早期に解決）", chukai: "中（売れるまで不安）", houchi: "高（老朽化・苦情・特定空き家リスク）" },
              ].map((row) => (
                <tr class="even:bg-bg">
                  <td class="border border-border px-3 py-2 font-bold text-text">{row.axis}</td>
                  <td class="border border-border px-3 py-2 text-center text-accent">{row.kaitori}</td>
                  <td class="border border-border px-3 py-2 text-center text-text">{row.chukai}</td>
                  <td class="border border-border px-3 py-2 text-center text-text-light">{row.houchi}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 rounded-lg bg-accent/5 border border-accent/20 px-4 py-3 text-sm font-bold text-accent">
          結論：急いで売る・訳あり・築古なら<strong>買取</strong>が有利。時間に余裕がある・築浅・好立地なら<strong>仲介</strong>を検討。<strong>放置は10年で固定資産税・管理費100〜300万円超の損失</strong>になるため最悪の選択。
        </p>
      </section>

      <section class="mt-10 rounded-xl border border-border bg-white p-6">
        <h2 class="mb-4 text-xl font-bold text-primary">買取実績（匿名・一部抜粋）</h2>
        <p class="mb-4 text-sm text-text-light">当社が実際に対応した訳あり物件の事例です。氏名・住所は匿名化しています。</p>
        <ul class="space-y-4">
          <li class="rounded-lg bg-gray-50 p-4">
            <p class="text-sm font-bold text-primary">大阪市内／相続アパート（築47年・満室率55%）</p>
            <p class="mt-1 text-sm text-text-light">相続後に管理が手に負えなくなり相談。入居者がいるまま現況買取。<strong>相談から14日で決済完了。</strong>他社では「入居者がいると難しい」と断られていたケース。</p>
          </li>
          <li class="rounded-lg bg-gray-50 p-4">
            <p class="text-sm font-bold text-primary">近畿圏某市／再建築不可の一戸建て（旗竿地・接道幅1.8m）</p>
            <p class="mt-1 text-sm text-text-light">大手仲介3社に断られた後、当社に相談。法律上の制限を前提とした現況買取で<strong>相談から8日で現金化。</strong>解体費・残置物処理も当社が負担。</p>
          </li>
          <li class="rounded-lg bg-gray-50 p-4">
            <p class="text-sm font-bold text-primary">大阪府内／共有持分（1/3・共有者と長年連絡不通）</p>
            <p class="mt-1 text-sm text-text-light">共有者の所在不明で身動きが取れない状態。持分のみの買取スキームを活用し<strong>相談から21日で解決。</strong>共有者への連絡・交渉も当社が代行。</p>
          </li>
        </ul>
      </section>

      <section class="mt-8 rounded-xl border border-border bg-white p-6">
        <h2 class="mb-4 text-xl font-bold text-primary">よくある質問</h2>
        <dl class="space-y-5">
          <div>
            <dt class="font-bold text-primary">Q. 査定は無料ですか？</dt>
            <dd class="mt-1 text-sm text-text-light">はい、完全無料です。査定依頼の時点では費用は一切発生しません。査定額を確認した上で売却するかどうかを判断していただけます。</dd>
          </div>
          <div>
            <dt class="font-bold text-primary">Q. 査定後、必ず売らなければなりませんか？しつこい営業はありますか？</dt>
            <dd class="mt-1 text-sm text-text-light">いいえ、売却義務はありません。査定額を把握した上で「売らない」という判断も歓迎します。当社は代表が直接対応するため、スタッフによるしつこい営業電話もありません。</dd>
          </div>
          <div>
            <dt class="font-bold text-primary">Q. 再建築不可・事故物件・共有持分・相続アパートも査定できますか？</dt>
            <dd class="mt-1 text-sm text-text-light">はい、すべて対応しています。通常の仲介では断られやすい訳あり物件（再建築不可・事故物件・共有持分・相続アパート・空き家・底地・借地権）でも、専門業者として買取査定が可能です。</dd>
          </div>
          <div>
            <dt class="font-bold text-primary">Q. 匿名で査定を依頼できますか？個人情報は守られますか？</dt>
            <dd class="mt-1 text-sm text-text-light">はい、匿名でご利用いただけます。このフォームでは氏名・連絡先の入力は任意です。まず概算金額を把握したい場合は、物件種別とエリアだけ選択して結果を確認してください。個人情報は当社のプライバシーポリシーに基づき第三者に提供しません。</dd>
          </div>
          <div>
            <dt class="font-bold text-primary">Q. 査定から現金化まで何日かかりますか？</dt>
            <dd class="mt-1 text-sm text-text-light">最短3日で現金化が可能です（物件の状態・権利関係が整っている場合）。一般的には相談から1〜2週間で決済まで完了します。急いで手放したい事情がある場合は、フォーム送信時にその旨をお伝えください。</dd>
          </div>
        </dl>
      </section>

    </div>
  </main>
</BaseLayout>

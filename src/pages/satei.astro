---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SateiForm from "../components/SateiForm.astro";

const faqs = [
  { question: "相談・査定は無料ですか？", answer: "はい、無料です。このページでは相談準備メモを作れます。買取価格は所在地や物件の状況を確認して個別にご案内します。" },
  { question: "相談したら売らなければなりませんか？", answer: "相談の時点で売却を決める必要はありません。提示された金額・売主側の費用・引き渡し条件を確認してからご検討ください。" },
  { question: "アパート・再建築不可・事故物件・共有持分も相談できますか？", answer: "大阪・兵庫・京都・奈良・滋賀・和歌山の物件についてご相談を受け付けています。買取の可否・条件は物件の状態や権利関係を確認してご案内します。" },
  { question: "情報がそろっていなくても相談できますか？", answer: "はい。準備メモの項目はすべて任意で、不明でも構いません。メモを作らずにLINEやお問い合わせフォームから相談することもできます。" },
  { question: "メモを作ると自動で送信されますか？", answer: "メモはこの画面に表示するだけで、自動送信されません。必要に応じてコピーし、LINEやお問い合わせフォームで送信内容をご確認ください。" },
  { question: "査定から現金化まで何日かかりますか？", answer: "物件調査・必要資料・登記や権利関係の確認にかかる期間によって異なります。希望する時期があれば、相談時にお知らせください。" },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "不動産の相談準備メモ",
  "description": "物件の種類・所在地・築年数・土地面積・入居状況を、相談前のメモに整理できます。",
  "applicationCategory": "BusinessApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" },
  "provider": { "@type": "RealEstateAgent", "name": "空き家のミカタ", "url": "https://akiya.arshe-corp.com" },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer } })),
};
---
<BaseLayout
  title="不動産の無料査定・相談準備メモ｜相続アパート・空き家【大阪・近畿対応】"
  description="大阪・近畿の相続アパート・空き家などの相談前に、所在地・築年数・入居状況をメモに整理できます。入力は任意・自動送信なし。買取価格は物件を確認して個別にご案内。相談・査定無料。"
  schema={schema}
  faqSchema={faqSchema}
>
  <PageHero
    label="無料査定の相談準備"
    title="わかる範囲の情報から相談できます"
    sub="売却するか迷っている段階でも構いません。まずは所在地と困っていることをお知らせください。"
    image="/images/site/satei-desk.webp"
  />
  <main class="min-h-screen bg-bg py-10">
    <div class="mx-auto max-w-3xl px-4">
      <SateiForm id="satei-page" />
      <section class="mt-10 rounded-xl border border-border bg-white p-6">
        <h2 class="mb-3 text-xl font-bold text-primary">買取・仲介・保有を比べるときの確認項目</h2>
        <p class="mb-4 text-sm text-text-light">金額だけでなく、売主側に残る費用と必要な期間も確認します。条件は物件ごとに異なります。</p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead><tr class="bg-primary/10">
              {["確認すること", "当社の直接買取", "仲介で売却", "保有を続ける"].map(label => <th class="border border-border p-3 text-left">{label}</th>)}
            </tr></thead>
            <tbody>
              {[
                ["金額", "個別査定で買取額を確認", "売出価格と成約見込みを相談", "現在の家賃収入と支出を確認"],
                ["費用", "当社の直接買取は仲介手数料なし。登記等の費用は別途確認", "仲介手数料・登記等の見積もりを確認", "税金・管理費・保険・修繕費を確認"],
                ["時期", "物件調査・権利確認後に日程を相談", "販売活動・買主との条件調整が必要", "今後の修繕予定と管理の負担を確認"],
                ["荷物・入居者", "残置物と賃貸契約の扱いを確認", "引き渡し条件を買主と調整", "管理会社との契約と入居状況を確認"],
              ].map(row => <tr class="even:bg-bg">{row.map(cell => <td class="border border-border p-3 align-top">{cell}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm"><a href="/guide/souzoku-apart-uritai-lp/" class="font-bold text-primary underline">相続アパートの手残りの比べ方・相談前のチェックを見る</a></p>
      </section>
      <section class="mt-8 rounded-xl border border-border bg-white p-6">
        <h2 class="mb-4 text-xl font-bold text-primary">よくある質問</h2>
        <dl class="space-y-5">
          {faqs.map(faq => <div><dt class="font-bold text-primary">Q. {faq.question}</dt><dd class="mt-1 text-sm text-text-light">{faq.answer}</dd></div>)}
        </dl>
      </section>
    </div>
  </main>
</BaseLayout>

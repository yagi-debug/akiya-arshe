---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const areas = await getCollection('area');
  return areas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const LINE_URL = "https://lin.ee/9Fk9EUl";

const SLASH = String.fromCharCode(47);
const formatPrice = (price) => {
  return `${(price / 10000).toFixed(0)}万円`;
};
const formatPriceRange = (price) => {
  return Math.round(price / 10000) + "万円" + SLASH + "m\u00B2\u301C";
};

const isOsakaWard = entry.data.prefecture === '大阪府' && entry.data.areaName.endsWith('区');

const breadcrumbs = isOsakaWard
  ? [
      { name: 'ホーム', url: '/' },
      { name: '大阪市の訳あり物件買取', url: '/osaka' },
      { name: `大阪市${entry.data.areaName}`, url: `/area/${entry.id}/` },
    ]
  : [
      { name: 'ホーム', url: '/' },
      { name: 'エリア相場', url: '/area' },
      { name: entry.data.areaName, url: `/area/${entry.id}/` },
    ];

const placeSchema = {
  "@type": "Place",
  "@id": `https://akiya.arshe-corp.com/area/${entry.id}#place`,
  "name": `${entry.data.prefecture}${entry.data.areaName}`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": entry.data.areaName,
    "addressRegion": entry.data.prefecture,
    "addressCountry": "JP",
  },
  ...(entry.data.lat && entry.data.lng ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": entry.data.lat,
      "longitude": entry.data.lng,
    }
  } : {}),
};

const realEstateListingSchema = {
  "@type": "RealEstateListing",
  "@id": `https://akiya.arshe-corp.com/area/${entry.id}#listing`,
  "name": `${entry.data.areaName}の不動産売却・買取`,
  "description": entry.data.description,
  "url": `https://akiya.arshe-corp.com/area/${entry.id}/`,
  "provider": {
    "@type": "RealEstateAgent",
    "name": "空き家のミカタ",
    "url": "https://akiya.arshe-corp.com",
    "areaServed": placeSchema,
  },
  "spatialCoverage": placeSchema,
  "priceRange": entry.data.avgPricePerSqm ? formatPriceRange(entry.data.avgPricePerSqm) : undefined,
};

const genericFaqEntities = [
  {
    "@type": "Question",
    "name": `${entry.data.areaName}の不動産売却に費用はかかりますか？`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "査定・相談は完全無料です。直接買取のため仲介手数料もかかりません。片付け・残置物もそのままで買い取れます。",
    },
  },
  {
    "@type": "Question",
    "name": `${entry.data.areaName}の物件は何日で現金化できますか？`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "最短3日での現金化が可能です。通常の仲介では3〜6ヶ月かかりますが、直接買取なら当社が買い手のため最短スピードで対応します。",
    },
  },
  {
    "@type": "Question",
    "name": `${entry.data.areaName}から遠方に住んでいても対応してもらえますか？`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "はい、全国対応しています。お客様が現地に来る必要はなく、手続きは郵送・オンラインで完結できます。",
    },
  },
  {
    "@type": "Question",
    "name": "名義変更（相続登記）が済んでいない不動産でも売却できますか？",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "相続登記が完了していない段階でもご相談いただけます。相続登記のサポートも含めてトータルでお手伝いします。",
    },
  },
  {
    "@type": "Question",
    "name": "再建築不可・事故物件・空き家などの訳あり物件でも買い取ってもらえますか？",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "はい、訳あり物件の買取が専門です。再建築不可・事故物件・共有持分・老朽化物件など、通常の仲介では売りにくい物件も直接買取しています。",
    },
  },
];

const areaFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": entry.data.faqs
    ? entry.data.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer,
        },
      }))
    : genericFaqEntities,
};

const localBusinessSchema = {
  "@type": "LocalBusiness",
  "@id": `https://akiya.arshe-corp.com/area/${entry.id}#localbusiness`,
  "name": "空き家のミカタ",
  "url": "https://akiya.arshe-corp.com",
  "parentOrganization": {
    "@id": "https://akiya.arshe-corp.com/#organization",
  },
  "serviceArea": placeSchema,
  "areaServed": placeSchema,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": `${entry.data.areaName}での訳あり不動産買取サービス`,
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "空き家・訳あり不動産の直接買取" } },
    ],
  },
};

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `https://akiya.arshe-corp.com/area/${entry.id}/#article`,
      "headline": entry.data.title,
      "description": entry.data.description,
      "image": {
        "@type": "ImageObject",
        "url": "https://akiya.arshe-corp.com/images/ogp-default.jpg",
        "width": 1200,
        "height": 630,
      },
      "datePublished": entry.data.publishDate,
      ...(entry.data.updatedDate ? { "dateModified": entry.data.updatedDate } : {}),
      "publisher": {
        "@type": "Organization",
        "@id": "https://akiya.arshe-corp.com/#organization",
        "name": "空き家のミカタ",
        "legalName": "合同会社アルシェ",
        "url": "https://akiya.arshe-corp.com",
        "hasCredential": {
          "@type": "EducationalOccupationalCredential",
          "name": "宅地建物取引業免許",
          "identifier": "大阪府知事(1)第65646号",
        },
      },
      "author": {
        "@type": "Person",
        "@id": "https://akiya.arshe-corp.com/about/hiroki#person",
        "name": "八木 宏樹",
        "jobTitle": "代表社員",
        "url": "https://akiya.arshe-corp.com/about/hiroki",
        "description": "合同会社アルシェ（宅建業免許: 大阪府知事(1)第65646号）代表。空き家のミカタ運営。訳あり不動産（再建築不可・共有持分・相続アパート・事故物件）の直接買取専門。",

        "worksFor": {
          "@type": "Organization",
          "@id": "https://akiya.arshe-corp.com/#organization",
        },
      },
      "about": placeSchema,
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", "h2", "blockquote", "table", ".speakable-highlight"],
      },
      ...(isOsakaWard ? {
        "isPartOf": {
          "@type": "WebPage",
          "@id": "https://akiya.arshe-corp.com/osaka/",
          "name": "大阪市の訳あり物件買取｜24区エリアから探す",
        },
      } : {}),
    },
    ...(isOsakaWard ? [{
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://akiya.arshe-corp.com/" },
        { "@type": "ListItem", "position": 2, "name": "大阪市の訳あり物件買取", "item": "https://akiya.arshe-corp.com/osaka/" },
        { "@type": "ListItem", "position": 3, "name": `大阪市${entry.data.areaName}`, "item": `https://akiya.arshe-corp.com/area/${entry.id}/` },
      ],
    }] : []),
    realEstateListingSchema,
    placeSchema,
    localBusinessSchema,
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  schema={articleSchema}
  faqSchema={areaFaqSchema}
  breadcrumbs={breadcrumbs}
  noindex={entry.data.noindex ?? false}
>
  <article class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <header class="mb-8">
      <h1 class="serif mb-4 text-2xl font-bold leading-relaxed text-text md:text-3xl">
        {entry.data.title}
      </h1>
      <p class="text-text-light">{entry.data.description}</p>
    </header>

    <div class="mb-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      <div class="rounded-lg bg-bg-dark p-4 text-center">
        <p class="mb-1 text-xs text-text-light">エリア</p>
        <p class="text-lg font-bold text-text">{entry.data.prefecture}{entry.data.areaName}</p>
      </div>
      {entry.data.avgPricePerSqm && (
        <div class="rounded-lg bg-bg-dark p-4 text-center">
          <p class="mb-1 text-xs text-text-light">マンション平均相場</p>
          <p class="text-lg font-bold text-accent">
            約{formatPrice(entry.data.avgPricePerSqm)}/m<sup>2</sup>
          </p>
        </div>
      )}
      {entry.data.population && (
        <div class="rounded-lg bg-bg-dark p-4 text-center">
          <p class="mb-1 text-xs text-text-light">人口</p>
          <p class="text-lg font-bold text-text">約{(entry.data.population / 10000).toFixed(0)}万人</p>
        </div>
      )}
    </div>

    <div class="prose prose-lg max-w-none
      prose-headings:text-text prose-headings:font-bold
      prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-l-4 prose-h2:border-accent prose-h2:pl-3 prose-h2:text-xl
      prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-lg
      prose-p:leading-relaxed prose-p:text-text
      prose-li:text-text
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
    ">
      <Content />
      <p class="mt-8">
        <a href="/satei" class="font-bold text-accent hover:underline">まずは無料査定で概算を確認する →</a>
      </p>
    </div>

    <div class="mt-10 rounded-lg border-2 border-accent bg-accent/5 p-6 text-center md:p-8">
      <h2 class="mb-3 text-xl font-bold text-text">
        {entry.data.areaName}の物件、いくらで売れる？
      </h2>
      <p class="mb-5 text-sm text-text-light">
        {entry.data.areaName}の不動産事情を熟知した宅建業者が対応します。
        まずは<strong class="text-text">無料AI査定</strong>で概算を確認できます（約60秒・個人情報の入力不要）。
      </p>
      <a
        href="/satei"
        class="mb-3 inline-flex w-full items-center justify-center rounded-lg bg-accent px-8 py-4 text-base font-bold text-white shadow transition-all hover:opacity-90 hover:shadow-md sm:w-auto"
      >
        無料AI査定で概算価格を見る →
      </a>
      <p class="mb-1 text-xs text-text-light">または、写真・住所を送って直接相談</p>
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-[#06C755] px-7 py-3 text-base font-bold text-[#06C755] transition-all hover:bg-[#06C755]/10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
        </svg>
        LINEで無料相談する
      </a>
      <p class="mt-3 text-xs text-text-light">相談無料・秘密厳守・宅建業者が対応</p>
    </div>

    <!-- 大阪市ピラーページへの明示的クラスターリンク（仮説1454: 区ページをクラスターとして位置付け） -->
    {isOsakaWard && (
      <div class="mt-10 rounded-lg border border-accent/30 bg-accent/5 p-4">
        <p class="mb-1 text-xs font-bold text-accent">大阪市24区の訳あり物件買取 総合ハブ</p>
        <p class="mb-2 text-sm text-text">
          このページは「<a href="/osaka" class="font-bold text-accent hover:underline">大阪市の訳あり物件買取（24区エリア）</a>」のクラスターページです。
          他の区の相場・事例や物件種別ガイドは総合ハブページでまとめてご確認いただけます。
        </p>
        <a href="/osaka" class="text-sm font-bold text-accent hover:underline">→ 大阪市24区ハブページを見る</a>
      </div>
    )}

    <!-- 物件タイプ別買取ガイド（ハブへの内部リンク） -->
    <div class="mt-10">
      <h2 class="mb-4 border-l-4 border-accent pl-3 text-xl font-bold text-text">
        {entry.data.areaName}で対応できる訳あり物件の種類
      </h2>
      <p class="mb-5 text-sm text-text-light">
        通常の不動産仲介では売りにくい「訳あり物件」も、全国対応の直接買取で対応しています。
      </p>
      <div class="grid gap-3 md:grid-cols-2">
        <a
          href="/guide/souzoku-apart-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">相続アパート</p>
            <p class="text-sm text-text-light">管理できない・空室が多い・老朽化したアパートも買取対応</p>
          </div>
        </a>
        <a
          href="/guide/akiya-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-8 9 8M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">空き家・放置物件</p>
            <p class="text-sm text-text-light">固定資産税増額リスクを回避。現況のまま直接買取</p>
          </div>
        </a>
        <a
          href="/guide/saikenchifu-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">再建築不可物件</p>
            <p class="text-sm text-text-light">接道義務不適合・袋地も買取対象。仲介で売れなかった物件に</p>
          </div>
        </a>
        <a
          href="/guide/jiko-bukken-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">事故物件</p>
            <p class="text-sm text-text-light">心理的瑕疵があっても買取可能。秘密厳守で対応</p>
          </div>
        </a>
        <a
          href="/guide/kyouyuu-mochibun-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">共有持分</p>
            <p class="text-sm text-text-light">他の共有者の同意なしで自分の持分だけ売却可能</p>
          </div>
        </a>
        <a
          href="/guide/sokochi-kaitori"
          class="flex items-start gap-3 rounded-lg border border-border p-4 transition-all hover:border-accent hover:shadow-md"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l3-9m0 0l3 9m-3-9V4m0 0L8.5 6.5M12 4l3.5 2.5M4 20h16" /></svg>
          </span>
          <div>
            <p class="font-bold text-text">底地・借地権</p>
            <p class="text-sm text-text-light">借地権付き土地（底地）も直接買取で対応</p>
          </div>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import PageHero from "../../components/PageHero.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'エリア相場', url: '/area' },
];

const areas = await getCollection('area', ({ data }) => !data.noindex);

// エリア名で相場の高い順にソート
const sortedAreas = areas.sort((a, b) =>
  (b.data.avgPricePerSqm || 0) - (a.data.avgPricePerSqm || 0)
);

const formatPrice = (price: number) => `${(price / 10000).toFixed(0)}万円`;
---

<BaseLayout
  title="全国エリア別 不動産売却相場｜宅建業者が解説"
  description="全国の主要エリア別に不動産売却相場をまとめました。大阪・福岡・名古屋・横浜・さいたま等のマンション・一戸建て・土地の最新相場データ。"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    label="対応物件・エリア"
    title="全国エリア別 不動産売却相場"
    sub="全国の主要エリアの不動産相場を宅建業者が解説。売却の参考にしてください。"
    image="/images/site/hero.webp"
  />
  <section class="px-4 py-12 md:py-16">
    <div class="mx-auto max-w-4xl">


      <!-- 相場比較表 -->
      <div class="mb-10 overflow-hidden rounded-xl border border-border bg-white shadow-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-4 py-3 text-left font-bold">エリア</th>
              <th class="px-4 py-3 text-right font-bold">マンション相場<br /><span class="text-xs font-normal text-white/70">（㎡単価）</span></th>
              <th class="hidden px-4 py-3 text-right font-bold md:table-cell">人口</th>
              <th class="px-4 py-3 text-center font-bold">詳細</th>
            </tr>
          </thead>
          <tbody>
            {sortedAreas.map((area, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-bg'}>
                <td class="px-4 py-3 font-bold text-text">
                  {area.data.prefecture}{area.data.areaName}
                </td>
                <td class="px-4 py-3 text-right text-accent font-bold">
                  {area.data.avgPricePerSqm ? `約${formatPrice(area.data.avgPricePerSqm)}/㎡` : '—'}
                </td>
                <td class="hidden px-4 py-3 text-right text-text-light md:table-cell">
                  {area.data.population ? `約${(area.data.population / 10000).toFixed(0)}万人` : '—'}
                </td>
                <td class="px-4 py-3 text-center">
                  <a
                    href={`/area/${area.id}`}
                    class="inline-block rounded bg-accent px-3 py-1 text-xs font-bold text-white transition-colors hover:bg-accent-light"
                  >
                    詳しく見る
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- 説明テキスト -->
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <h2 class="mb-3 text-lg font-bold text-primary">相場データについて</h2>
        <p class="mb-3 text-sm leading-relaxed text-text-light">
          掲載している相場データは、国土交通省「不動産取引価格情報」やREINSマーケットインフォメーション等の公的データをもとに、当社が独自に分析・整理したものです。
        </p>
        <p class="mb-3 text-sm leading-relaxed text-text-light">
          実際の売却価格は、物件の状態・立地条件・市場動向によって大きく異なります。正確な査定は、お気軽にご相談ください。
        </p>

        <div class="mt-4 rounded-lg bg-primary/5 p-4 text-center">
          <p class="mb-2 text-sm font-bold text-primary">あなたの物件はいくらで売れる？</p>
          <a
            href="https://lin.ee/9Fk9EUl"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[#06C755] px-6 py-3 text-sm font-bold text-white transition-all hover:bg-[#05b64d]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
            </svg>
            LINEで無料査定を依頼する
          </a>
        </div>
      </div>

      <!-- 対応エリア説明 -->
      <div class="mt-8 text-center">
        <p class="text-sm text-text-light">
          上記以外のエリアも対応しています。全国どこでも訳あり不動産の買取が可能です。お気軽にご相談ください。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

const allSchemas = schema ? [organizationSchema, websiteSchema, schema] : [organizationSchema, websiteSchema];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="GqwOoxndCWJQybRlsSVMSNgIf1CV2zU5W9x1ZOvW49E" />

    <!-- Bing Webmaster Tools -->
    <meta name="msvalidate.01" content="5EB3B406001D1FF53AD7AEA615701FA8" />

    <!-- Google Analytics (GA4) + コンバージョン計測 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DB12JFF39R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DB12JFF39R');

      // コンバージョンイベント計測
      document.addEventListener('DOMContentLoaded', function() {
        var pagePath = window.location.pathname;
        var pageTitle = document.title;

        // LINE友だち追加クリック
        document.querySelectorAll('a[href*="lin.ee"]').forEach(function(el) {
          el.addEventListener('click', function() {
            gtag('event', 'line_click', {
              event_category: 'conversion',
              event_label: el.textContent.trim().substring(0, 50),
              page_path: pagePath,
              page_title: pageTitle,
              link_url: el.href
            });
          });
        });
        // 電話タップ
        document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            gtag('event', 'phone_click', {
              event_category: 'conversion',
              event_label: el.href.replace('tel:', ''),
              page_path: pagePath,
              page_title: pageTitle
            });
          });
        });
        // メールクリック
        document.querySelectorAll('a[href^="mailto:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            gtag('event', 'email_click', {
              event_category: 'conversion',
              event_label: 'info.arshe@arshe-corp.com',
              page_path: pagePath,
              page_title: pageTitle
            });
          });
        });
        // フォーム送信
        document.querySelectorAll('form').forEach(function(form) {
          form.addEventListener('submit', function() {
            gtag('event', 'form_submit', {
              event_category: 'conversion',
              event_label: 'contact_form',
              page_path: pagePath,
              page_title: pageTitle
            });
          });
        });
      });
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Shippori+Mincho:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="空き家のミカタ｜訳あり不動産の買取専門" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {howToSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />

    {breadcrumbs && breadcrumbs.length > 0 && (
      <div class="mx-auto w-full max-w-5xl px-4 pt-4">
        <Breadcrumb items={breadcrumbs} />
      </div>
    )}

    <main class="flex-1">
      <slot />
    </main>

    <CTA />
    <Footer />

    <!-- モバイルCTAバーに隠れないための余白 -->
    <div class="h-16 md:hidden" aria-hidden="true"></div>
    <CtaDock />

    <!-- スクロールリビール（.reveal に .is-visible を付与） -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".reveal");
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

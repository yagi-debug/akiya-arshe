---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  schema?: object;
  faqSchema?: object | null;
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, schema, faqSchema, breadcrumbs } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, "https://akiya.arshe-corp.com");

const baseSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "空き家のミカタ",
  "url": "https://akiya.arshe-corp.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "小路3-17-19",
    "addressLocality": "大阪市生野区",
    "addressRegion": "大阪府",
    "postalCode": "544-0002",
    "addressCountry": "JP",
  },
  "areaServed": {
    "@type": "Country",
    "name": "日本",
  },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "name": "宅地建物取引業免許",
    "credentialCategory": "license",
    "recognizedBy": {
      "@type": "GovernmentOrganization",
      "name": "大阪府知事",
    },
    "identifier": "大阪府知事 (1) 第65646号",
  },
  "employee": {
    "@type": "Person",
    "name": "八木 宏樹",
    "jobTitle": "代表社員・宅地建物取引士",
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "宅地建物取引士",
      "credentialCategory": "license",
    },
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "訳あり不動産 直接買取サービス",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "相続アパート買取", "url": "https://akiya.arshe-corp.com/guide/souzoku-apart-kaitori" },
      },
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "空き家・放置物件買取", "url": "https://akiya.arshe-corp.com/guide/akiya-kaitori" },
      },
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "再建築不可物件買取", "url": "https://akiya.arshe-corp.com/guide/saikenchifu-kaitori" },
      },
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "事故物件買取", "url": "https://akiya.arshe-corp.com/guide/jiko-bukken-kaitori" },
      },
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "共有持分買取", "url": "https://akiya.arshe-corp.com/guide/kyouyuu-mochibun-kaitori" },
      },
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Service", "name": "底地・借地権買取", "url": "https://akiya.arshe-corp.com/guide/sokochi-kaitori" },
      },
    ],
  },
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "Service",
      "name": "訳あり不動産の直接買取",
      "description": "空き家・再建築不可・事故物件・共有持分・相続物件など、訳あり不動産を直接買取。仲介手数料なし・現況買取・全国対応。",
    },
  },
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": `https://akiya.arshe-corp.com${item.url}`,
  })),
} : null;

const allSchemas = schema ? [baseSchema, schema] : [baseSchema];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="GqwOoxndCWJQybRlsSVMSNgIf1CV2zU5W9x1ZOvW49E" />

    <!-- Google Analytics (GA4) + コンバージョン計測 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DB12JFF39R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DB12JFF39R');

      // コンバージョンイベント計測
      document.addEventListener('DOMContentLoaded', function() {
        var pagePath = window.location.pathname;
        var pageTitle = document.title;

        // LINE友だち追加クリック
        document.querySelectorAll('a[href*="lin.ee"]').forEach(function(el) {
          el.addEventListener('click', function() {
            gtag('event', 'line_click', {
              event_category: 'conversion',
              event_label: el.textContent.trim().substring(0, 50),
              page_path: pagePath,
              page_title: pageTitle,
              link_url: el.href
            });
          });
        });
        // 電話タップ
        // メールクリック
        document.querySelectorAll('a[href^="mailto:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            gtag('event', 'email_click', {
              event_category: 'conversion',
              event_label: 'info.arshe@arshe-corp.com',
              page_path: pagePath,
              page_title: pageTitle
            });
          });
        });
        // フォーム送信
        document.querySelectorAll('form').forEach(function(form) {
          form.addEventListener('submit', function() {
            gtag('event', 'form_submit', {
              event_category: 'conversion',
              event_label: 'contact_form',
              page_path: pagePath,
              page_title: pageTitle
            });
          });
        });
      });
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="空き家のミカタ｜訳あり不動産の買取専門" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />

    {breadcrumbs && breadcrumbs.length > 0 && (
      <div class="mx-auto w-full max-w-5xl px-4 pt-4">
        <Breadcrumb items={breadcrumbs} />
      </div>
    )}

    <main class="flex-1">
      <slot />
    </main>

    <CTA />
    <Footer />
  </body>
</html>
